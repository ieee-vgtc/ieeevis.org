# Copy this file to .env for local development. Do not commit .env.
#
# The local callback URL must also be listed in the Auth0 application's
# Allowed Callback URLs:
# http://localhost:4321/year/2026/auth/callback

AUTH0_DOMAIN=ieeevis.us.auth0.com
AUTH0_CLIENT_ID=replace-with-your-client-id
AUTH0_CLIENT_SECRET=replace-with-your-client-secret
AUTH0_CONNECTION=vis26-attendees

# This must exactly match the protocol, host, and base path used by the app.
APP_BASE_URL=http://localhost:4321/year/2026

# Generate a unique value with: openssl rand -hex 32
AUTH0_SESSION_SECRET=replace-with-a-random-64-character-hex-string

# Shared secret for /auth/token, which lets signed-in attendees post to the
# VIS Bluesky discussions (bsky.tech.ieeevis.org) without a Bluesky account.
# Must match the bridge's BSKY_EMBED_TOKEN_SECRET (ask the tech chairs).
AUTH_EMBED_TOKEN_SECRET=replace-with-a-random-64-character-hex-string
