# Copy this file to .env for local development. Do not commit .env.
#
# Attendee sign-in (src/lib/auth0Client.ts) runs entirely in the browser
# against an Auth0 application of type "Single Page Application" — not the
# "Regular Web Application" type used before this moved to a client-only SPA
# flow; that type expects a client secret this flow never sends, and these
# PUBLIC_ values are not secret regardless (Astro only exposes PUBLIC_-
# prefixed vars to the browser, which is the point of the prefix).
#
# The Auth0 application needs:
#   Allowed Callback URLs: http://localhost:4321/year/2026/auth/callback/
#     (trailing slash required; see CALLBACK_PATH in src/lib/auth0Client.ts)
#     (plus the same path on every other origin this site is served from —
#     each Netlify deploy preview, staging, production)
#   Allowed Logout URLs: http://localhost:4321/year/2026/
#     (plus the same path on every other origin, as above)
#   Allowed Web Origins: http://localhost:4321 (plus every other origin, no
#     path) — needed for the SDK's CORS requests to Auth0's token endpoint
#   Advanced Settings -> Grant Types: "Refresh Token" checked, and
#     "offline_access" allowed, for sessions to survive the ID token's own
#     expiry without relying on a third-party-cookie silent-auth iframe
PUBLIC_AUTH0_DOMAIN=ieeevis.us.auth0.com
PUBLIC_AUTH0_CLIENT_ID=replace-with-your-spa-applications-client-id

# Optional: skips Auth0's connection picker and goes straight to one
# connection.
PUBLIC_AUTH0_CONNECTION=vis26-attendees

# Optional: where bsky-api lives (the Bluesky discussions, guest comments,
# saving a Bluesky handle, the account page). Defaults to
# https://bsky.tech.ieeevis.org; point it at a local Supabase to test against
# a local bsky-api. The site sends it the attendee's ID token and keeps no
# secret of its own.
# PUBLIC_BSKY_API_BASE=http://127.0.0.1:8000/functions/v1/bsky-api
