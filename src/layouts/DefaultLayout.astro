---
import "/src/styles/global.css";

import { load_yaml } from "../utils/load_yaml";
import { source_file_for_pathname } from "../utils/source_file";

const footer_data = load_yaml("./src/data/footer.yml");
const navigation_data = load_yaml("./src/data/navigation.yml");

import Head from "../components/Head";
import Navigation from "../components/Navigation";
import ProgramTopBar from "../components/ProgramTopBar.astro";
import Footer from "../components/Footer";

const { page_info } = Astro.props;
const { pathname } = Astro.url;

const isProgramPage = /year\/202\d\/program/.test(pathname);
const source_file = source_file_for_pathname(pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      description={page_info.description || undefined}
      title={page_info.title || ""}
      url={Astro.url}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;700&family=Zilla+Slab:wght@500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
  </head>
  <body id="app" class="overflow-x-hidden">
    <Navigation nav_data={navigation_data} page_info={page_info} client:load />
    {isProgramPage && <ProgramTopBar />}

    <main>
      <slot />
    </main>

    <Footer
      pathname={pathname}
      footer_data={footer_data}
      contact={page_info.contact}
      source_file={source_file}
    />
  </body>
</html>
