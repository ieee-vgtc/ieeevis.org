---
import Sidebar from "../components/Sidebar.astro";
import DefaultLayout from "./DefaultLayout.astro";
const { frontmatter } = Astro.props;
const fullWidth = Boolean(frontmatter.full_width);
const { pathname } = Astro.url;

const isProgramPage = /year\/202\d\/program/.test(pathname);
---

<DefaultLayout page_info={frontmatter}>
  <!-- section header -->
  {
    !isProgramPage && (
      <div class="section">
        <div class="header">
          <div class="container">
            <h1 class="mb-0">{frontmatter.title}</h1>
          </div>
        </div>
      </div>
    )
  }

  {
    fullWidth ? (
      <div class="container md:py-16">
        <article class="content w-full md:mt-0 mt-8">
          <slot />
        </article>
      </div>
    ) : (
      <div class="container md:py-16 flex md:flex-row flex-col justify-between">
        <article class="content md:w-3/5 w-full md:mt-0 mt-8 md:order-0 order-2">
          <slot />
        </article>

        {frontmatter.sidebar && (
          <Sidebar sidebar_data_path={frontmatter.sidebar} />
        )}

        <slot name="sidebar" />
      </div>
    )
  }
</DefaultLayout>
