        id: "w-my-event-2",
        event_prefix: "w-my-event",
        track: "1_15_1_16",
        room_name: "Room 1.15 + 1.16",
        chair: [
          "FirstName1 LastName1",
          "FirstName2 LastName2",
          "FirstName3 LastName3",
          "FirstName4 LastName4",
          "FirstName5 LastName5",
        ],
        time_start: "2026-11-02T10:00:00+00:00",
        time_end: "2026-11-02T11:30:00+00:00",
        discord_link: "https://discord.com/channels/123/456",
        youtube_url: null,
        time_slots: [],
      },
    ],
    title: "My Event Name",
    type: "workshop",
    url: "https://github.com/ieee-vgtc/ieeevis.org",
