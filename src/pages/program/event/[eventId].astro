      "room-0_94_0_95": "Room 0.94 + 0.95",
      "room-0_96_0_97": "Room 0.96 + 0.97",
      "room-1_14": "Room 1.14",
      "room-1_15_1_16": "Room 1.15 + 1.16",
      "room-1_32_1_33": "Room 1.32 + 1.33",
      "room-1_61_1_62": "Room 1.61 + 1.62",
      "room-1_85_1_86": "Room 1.85 + 1.86",
      "room-e1": "Hall E1",
      "room-e2": "Hall E2",
