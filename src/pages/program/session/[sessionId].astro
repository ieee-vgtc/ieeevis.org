---
import PageLayout from "../../../layouts/PageLayout.astro";
import BlueskyDiscussion from "../../../components/BlueskyDiscussion";
import { fetchAllSessions } from "../../../utils/paperData";
import { hasOwnDiscussion } from "../../../utils/discussionSlots";
import type {
  ProgramSession,
  ProgramSessionList,
} from "../../../types/program";
import { getProgramEventTypeLabel } from "../../../utils/programEventTypeLabel";
import { withBaseURL } from "../../../utils/withBaseURL";

// The site runs output: "server" (needed for the Auth0 callback route), which
// makes every page dynamic by default and silently ignores getStaticPaths()
// below unless a page opts back into prerendering explicitly.
export const prerender = true;

type EventPageProps = {
  sessionId: string;
  event: ProgramSessionList[string];
  session: ProgramSession;
};

export async function getStaticPaths() {
  const sessionList = await fetchAllSessions();
  const paths: Array<{ params: { sessionId: string }; props: EventPageProps }> =
    [];

  for (const event of Object.values(sessionList)) {
    for (const session of event.sessions) {
      const prefixedId = `${session.event_prefix}-${session.session_id}`;
      const legacyId = session.session_id;

      paths.push({
        params: { sessionId: prefixedId },
        props: { sessionId: prefixedId, event, session },
      });

      // Backward compatibility with old non-prefixed session IDs.
      paths.push({
        params: { sessionId: legacyId },
        props: { sessionId: legacyId, event, session },
      });
    }
  }

  return paths;
}

const { event, session } = Astro.props as EventPageProps;

const presentations = [...session.time_slots].sort(
  (a, b) => Date.parse(a.time_start) - Date.parse(b.time_start),
);

const sessionDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "US/Eastern",
  weekday: "long",
  month: "short",
  day: "numeric",
});

const timeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "US/Eastern",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});

function formatSlotRange(startISO: string, endISO: string) {
  const start = new Date(startISO);
  const end = new Date(endISO);
  return `${timeFormatter.format(start)} - ${timeFormatter.format(end)}`;
}

function formatSessionDateTime(startISO: string, endISO: string) {
  const start = new Date(startISO);
  const end = new Date(endISO);
  return `${sessionDateFormatter.format(start)} @ ${timeFormatter.format(start)} - ${timeFormatter.format(end)} (US/Eastern)`;
}

const eventTypeLabel = getProgramEventTypeLabel(event.event_type || "other");
const programUrl = withBaseURL(
  `/program/sessions/?type=${encodeURIComponent(event.event_type || "other")}`,
);

// Workshops, tutorials, and panels are described as a whole rather than by
// their presentations. Panels share one event, so their details live on the
// session; workshops and tutorials are one event each.
const describedEventTypes = ["workshop", "tutorial", "panel"];
const normalizedEventType = (event.event_type || "").toLowerCase();
const isDescribedEvent = describedEventTypes.includes(normalizedEventType);
const isPanel = normalizedEventType === "panel";
const usesOrganizerLabel = isPanel || normalizedEventType === "tutorial";
// A session's own details (panels, invited talks) apply to any event type.
const description =
  session.description || (isDescribedEvent ? event.event_description : "");
const rawWebsiteUrl = session.url || (isDescribedEvent ? event.event_url : "");
// Site paths (e.g. an invited speaker's info page) need the base URL.
const websiteUrl = rawWebsiteUrl && withBaseURL(rawWebsiteUrl);
const isExternalWebsite = /^https?:\/\//.test(websiteUrl);

const frontmatter = {
  title: `${eventTypeLabel}: ${session.title}`,
  active_nav: "Program",
  contact: "web@ieeevis.org",
  full_width: true,
};
---

<PageLayout frontmatter={frontmatter}>
  <div class="prose max-w-4xl">
    <nav class="breadcrumb not-prose" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={programUrl} class="breadcrumb__link">{eventTypeLabel}</a>
        </li>
        <li class="breadcrumb__sep" aria-hidden="true">›</li>
        <li
          class="breadcrumb__item breadcrumb__item--current"
          aria-current="page"
        >
          <span class="breadcrumb__current">{session.title}</span>
        </li>
      </ol>
    </nav>
    <h1>{eventTypeLabel}: {session.title}</h1>
    <section class="program-event-page">
      <p class="program-event-meta">
        <strong class="mr-2">Session chair:</strong>
        {session.chair?.join(", ") || "TBA"}
      </p>
      <p class="program-event-meta">
        <strong class="mr-2">Room:</strong>
        {session.room_name || "TBA"}
      </p>
      <p class="program-event-meta">
        <strong class="mr-2">Time:</strong>
        {formatSessionDateTime(session.time_start, session.time_end)}
      </p>

      {
        event.organizers.length > 0 && (
          <p class="program-event-organizers">
            <strong class="mr-2">Organizers:</strong>
            {event.organizers.join(", ")}
          </p>
        )
      }

      {
        websiteUrl &&
          (isExternalWebsite ? (
            <p class="program-event-meta">
              <strong class="mr-2">Website:</strong>
              <a href={websiteUrl}>{websiteUrl}</a>
            </p>
          ) : (
            <p class="program-event-meta">
              <a href={websiteUrl}>More information about this session</a>
            </p>
          ))
      }

      {description && <p class="program-event-description">{description}</p>}

      {
        (presentations.length > 0 || !description) && (
          <h2>Presentations in this session</h2>
        )
      }

      <div class="program-presentations">
        {
          presentations.length === 0 && !description && (
            <p>
              No presentations are scheduled for this session. If this event is
              a workshop or tutorial, please check the workshop or tutorial page
              for more information.
            </p>
          )
        }
        {
          presentations.map((slot) => (
            <article class="program-presentation">
              <p class="program-presentation-time">
                {formatSlotRange(slot.time_start, slot.time_end)}
              </p>
              {slot.uid ? (
                <h3>
                  <a
                    href={withBaseURL(
                      `/program/${slot.paper_type.includes("oster") ? "poster" : "paper"}/${slot.uid}`,
                    )}
                  >
                    {slot.title}
                  </a>
                </h3>
              ) : slot.url ? (
                <h3>
                  <a href={withBaseURL(slot.url)}>{slot.title}</a>
                </h3>
              ) : (
                <h3>{slot.title}</h3>
              )}
              {slot.authors && slot.authors.length > 0 && (
                <p class="program-presentation-authors">
                  {usesOrganizerLabel ||
                  slot.paper_type.toLowerCase() === "tutorial" ? (
                    <strong class="mr-2">Organizers:</strong>
                  ) : (
                    "Authors: "
                  )}
                  {slot.authors.map((author) => author.name).join(", ")}
                </p>
              )}
              {isDescribedEvent &&
                slot.contributors &&
                slot.contributors.length > 0 && (
                  <p class="program-presentation-contrib">
                    {isPanel && <strong class="mr-2">Panelists:</strong>}
                    {slot.contributors.join(", ")}
                  </p>
                )}
              {/* Panels and invited talks have no paper page, so their Bluesky
                discussion — the thread of replies to the announcement post,
                proxied through bsky.tech.ieeevis.org — belongs here. */}
              {hasOwnDiscussion(slot) && (
                <div class="program-presentation-discussion not-prose">
                  <BlueskyDiscussion client:visible paperId={slot.slot_id} />
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>
  </div>

  <style>
    .breadcrumb {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.75rem 0;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid #dee2e6;
      font-size: 0.875rem;
    }

    .breadcrumb__list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;
    }

    .breadcrumb__sep {
      color: #adb5bd;
      user-select: none;
    }

    .breadcrumb__link {
      color: var(--color-accent);
      text-decoration: none;
    }

    .breadcrumb__link:visited {
      color: var(--color-primary-800);
    }

    .breadcrumb__link:hover {
      text-decoration: underline;
    }

    .breadcrumb__current {
      color: #555;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .program-event-page {
      display: grid;
      gap: 0.8rem;
    }

    .program-event-page h1 {
      margin: 0;
    }

    .program-event-page h2 {
      margin: 0.2rem 0 0;
      color: var(--color-accent);
      font-size: 1.15rem;
    }

    .program-event-id {
      margin: 0;
      font-size: 0.78rem;
      color: var(--color-gray-700);
    }

    .program-event-link,
    .program-event-meta,
    .program-event-organizers,
    .program-event-description {
      margin: 0;
      color: var(--color-gray-800);
    }

    .program-presentations {
      display: grid;
      gap: 0.7rem;
    }

    .program-presentation {
      border-top: 1px dashed var(--color-gray-900);
      padding-top: 0.5rem;
      display: grid;
      gap: 0.2rem;
    }

    .program-presentation-time {
      margin: 0;
      color: var(--color-gray-700);
      font-weight: 700;
      font-size: 0.82rem;
    }

    .program-presentation h3 {
      margin: 0;
      font-size: 1rem;
      line-height: 1.3;
    }

    .program-presentation-authors,
    .program-presentation-contrib {
      margin: 0;
      color: var(--color-gray-700);
      font-size: 0.9rem;
    }

    .program-presentation-discussion {
      margin-top: 0.6rem;
    }
  </style>
</PageLayout>
