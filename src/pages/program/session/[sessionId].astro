---
import ProgramPeopleList from "../../../components/ProgramPeopleList.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import AwardBadge from "../../../components/AwardBadge.astro";
import BlueskyDiscussion from "../../../components/BlueskyDiscussion";
import { fetchAllPapers, fetchAllSessions } from "../../../utils/paperData";
import { hasOwnDiscussion } from "../../../utils/discussionSlots";
import type { Paper } from "../../../types/paper";
import type {
  ProgramSession,
  ProgramSessionList,
} from "../../../types/program";
import { getProgramEventTypeLabel } from "../../../utils/programEventTypeLabel";
import { withBaseURL } from "../../../utils/withBaseURL";

// The site runs output: "server" (needed for the Auth0 callback route), which
// makes every page dynamic by default and silently ignores getStaticPaths()
// below unless a page opts back into prerendering explicitly.
export const prerender = true;

type EventPageProps = {
  sessionId: string;
  event: ProgramSessionList[string];
  session: ProgramSession;
  eventPapers: Paper[];
};

export async function getStaticPaths() {
  const [sessionList, papers] = await Promise.all([
    fetchAllSessions(),
    fetchAllPapers(),
  ]);
  const papersByEventPrefix = papers.reduce<Map<string, Paper[]>>(
    (byPrefix, paper) => {
      const eventPapers = byPrefix.get(paper.event_prefix) || [];
      eventPapers.push(paper);
      byPrefix.set(paper.event_prefix, eventPapers);
      return byPrefix;
    },
    new Map(),
  );
  const paths: Array<{ params: { sessionId: string }; props: EventPageProps }> =
    [];

  for (const event of Object.values(sessionList)) {
    const eventPapers =
      event.event_type === "workshop"
        ? (papersByEventPrefix.get(event.event_prefix) || [])
            .slice()
            .sort((a, b) => a.title.localeCompare(b.title))
        : [];

    for (const session of event.sessions) {
      const prefixedId = `${session.event_prefix}-${session.session_id}`;
      const legacyId = session.session_id;

      paths.push({
        params: { sessionId: prefixedId },
        props: {
          sessionId: prefixedId,
          event,
          session,
          eventPapers,
        },
      });

      // Backward compatibility with old non-prefixed session IDs.
      paths.push({
        params: { sessionId: legacyId },
        props: {
          sessionId: legacyId,
          event,
          session,
          eventPapers,
        },
      });
    }
  }

  return paths;
}

const { event, session, eventPapers } = Astro.props as EventPageProps;

const presentations = [...session.time_slots].sort(
  (a, b) => Date.parse(a.time_start) - Date.parse(b.time_start),
);

const sessionDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "US/Eastern",
  weekday: "long",
  month: "short",
  day: "numeric",
});

const timeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: "US/Eastern",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});

function formatSlotRange(startISO: string, endISO: string) {
  const start = new Date(startISO);
  const end = new Date(endISO);
  return `${timeFormatter.format(start)} - ${timeFormatter.format(end)}`;
}

function formatSessionDateTime(startISO: string, endISO: string) {
  const start = new Date(startISO);
  const end = new Date(endISO);
  return `${sessionDateFormatter.format(start)} @ ${timeFormatter.format(start)} - ${timeFormatter.format(end)} (US/Eastern)`;
}

const eventTypeLabel = getProgramEventTypeLabel(event.event_type || "other");
const programUrl = withBaseURL(
  `/program/sessions/?type=${encodeURIComponent(event.event_type || "other")}`,
);

// Workshops, tutorials, and panels are described as a whole rather than by
// their presentations. Panels share one event, so their details live on the
// session; workshops and tutorials are one event each.
const describedEventTypes = ["workshop", "tutorial", "panel"];
const normalizedEventType = (event.event_type || "").toLowerCase();
const isDescribedEvent = describedEventTypes.includes(normalizedEventType);
const isPanel = normalizedEventType === "panel";
const workshopPapers =
  normalizedEventType === "workshop" && presentations.length === 0
    ? eventPapers
    : [];
const usesOrganizerLabel = isPanel || normalizedEventType === "tutorial";
// A session's own details (panels, invited talks) apply to any event type.
const description =
  session.description || (isDescribedEvent ? event.event_description : "");
const rawWebsiteUrl = session.url || (isDescribedEvent ? event.event_url : "");
// Site paths (e.g. an invited speaker's info page) need the base URL.
const websiteUrl = rawWebsiteUrl && withBaseURL(rawWebsiteUrl);
const isExternalWebsite = /^https?:\/\//.test(websiteUrl);

const frontmatter = {
  title: `${eventTypeLabel}: ${session.title}`,
  active_nav: "Program",
  contact: "web@ieeevis.org",
  full_width: true,
};
---

<PageLayout frontmatter={frontmatter}>
  <div class="prose w-full max-w-none">
    <nav class="breadcrumb not-prose" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={programUrl} class="breadcrumb__link">{eventTypeLabel}</a>
        </li>
        <li class="breadcrumb__sep" aria-hidden="true">›</li>
        <li
          class="breadcrumb__item breadcrumb__item--current"
          aria-current="page"
        >
          <span class="breadcrumb__current">{session.title}</span>
        </li>
      </ol>
    </nav>
    
    <header class="paper-hero not-prose">
      <h1>{session.title}</h1>
      <br/>
      <p class="program-event-meta">
        <strong class="mr-2">Session chair:</strong>
        {session.chairPeople?.length ? (
          <ProgramPeopleList people={session.chairPeople} />
        ) : session.chair?.join(", ") || "TBA"}
      </p>
      <p class="program-event-meta">
        <strong class="mr-2">Room:</strong>
        {session.room_name || "TBA"}
      </p>
      <p class="program-event-meta">
        <strong class="mr-2">Time:</strong>
        {formatSessionDateTime(session.time_start, session.time_end)}
      </p>

      {
        event.organizers.length > 0 && (
          <p class="program-event-organizers">
            <strong class="mr-2">Organizers:</strong>
            {event.organizers.map((author, idx) => (
              <a
                class="mr-1"
                href={`/year/2026/program/papers/?filter=author&search=${author.replaceAll(" ", "+")}`}
              >
                {author}
                {idx !== event.organizers.length - 1 ? "," : ""}
              </a>
            ))}
          </p>
        )
      }

      {
        websiteUrl &&
          (isExternalWebsite ? (
            <p class="program-event-meta">
              <strong class="mr-2">Website:</strong>
              <a href={websiteUrl}>{websiteUrl}</a>
            </p>
          ) : (
            <p class="program-event-meta">
              <a href={websiteUrl}>More information about this session</a>
            </p>
          ))
      }

      {description && <p class="program-event-description">{description}</p>}
    </header>

    <div>
      {
        presentations.length > 0 ? (
          <h2>Presentations in this session</h2>
        ) : workshopPapers.length > 0 ? (
          <h2>Workshop papers</h2>
        ) : (
          !description && <h2>Presentations in this session</h2>
        )
      }
    </div>

    <div>
      {
        presentations.length === 0 &&
          workshopPapers.length === 0 &&
          !description && (
            <section class="paper-section">
              No presentations are scheduled for this session. Please check
              the event website for more information.
            </section>
          )
      }
      {
        presentations.map((slot) => (
          <section class="paper-section">
            <p class="program-presentation-time">
              {formatSlotRange(slot.time_start, slot.time_end)}
            </p>
            {slot.uid ? (
              <h3>
                <a
                  href={withBaseURL(
                    `/program/${slot.paper_type.includes("oster") ? "poster" : "paper"}/${slot.uid}`,
                  )}
                >
                  {slot.title}
                </a>
              </h3>
            ) : slot.url ? (
              <h3>
                <a href={withBaseURL(slot.url)}>{slot.title}</a>
              </h3>
            ) : (
              <h3>{slot.title}</h3>
            )}
            {slot.paper_award && (
              <p class="program-presentation-award">
                <AwardBadge award={slot.paper_award} compact />
              </p>
            )}
            {slot.authors && slot.authors.length > 0 && (
              <p class="program-presentation-authors">
                {usesOrganizerLabel ||
                slot.paper_type.toLowerCase() === "tutorial" ? (
                  <strong class="mr-2">Organizers:</strong>
                ) : (
                  "Authors: "
                )}
                <ProgramPeopleList people={slot.authors} linkNames />
              </p>
            )}
            {isDescribedEvent &&
              slot.contributors &&
              slot.contributors.length > 0 && (
                <p class="program-presentation-contrib">
                  {isPanel && <strong class="mr-2">Panelists:</strong>}
                  {slot.contributors.map((author, idx) => (
                    <a
                      class="mr-1"
                      href={`/year/2026/program/papers/?filter=author&search=${author.replaceAll(" ", "+")}`}
                    >
                      {author}
                      {slot.contributors &&
                      idx !== slot.contributors.length - 1
                        ? ","
                        : ""}
                    </a>
                  ))}
                </p>
              )}
            {/* Panels and invited talks have no paper page, so their Bluesky
              discussion — the thread of replies to the announcement post,
              proxied through bsky.tech.ieeevis.org — belongs here. */}
            {hasOwnDiscussion(slot) && (
              <div class="program-presentation-discussion not-prose">
                <BlueskyDiscussion client:visible paperId={slot.slot_id} />
              </div>
            )}
          </section>
        ))
      }
      {
        workshopPapers.map((paper) => (
          <section class="paper-section">
            <h3>
              <a href={withBaseURL(`/program/paper/${paper.id}`)}>
                {paper.title}
              </a>
            </h3>
            {paper.authors && paper.authors.length > 0 && (
              <p class="program-presentation-authors">
                Authors:{" "}
                <ProgramPeopleList people={paper.authors} linkNames />
              </p>
            )}
          </section>
        ))
      }
    </div>
  </div>

  <style>
    .breadcrumb {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.75rem 0;
      margin-bottom: 1.5rem;
      border-bottom: 1px solid #dee2e6;
      font-size: 0.875rem;
    }

    .breadcrumb__list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem;
      list-style: none;
      margin: 0;
      padding: 0;
      flex: 1;
    }

    .breadcrumb__sep {
      color: #adb5bd;
      user-select: none;
    }

    .breadcrumb__link {
      color: var(--color-accent);
      text-decoration: none;
    }

    .breadcrumb__link:visited {
      color: var(--color-primary-800);
    }

    .breadcrumb__link:hover {
      text-decoration: underline;
    }

    .breadcrumb__current {
      color: #555;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    h2 {
      max-width: 62rem;
      margin-left: auto;
      margin-right: auto;
      font-size: 1.5rem;
    }


    .program-event-meta,
    .program-event-organizers,
    .program-event-description {
      margin: 0;
      color: var(--color-gray-800);
    }

    .program-presentation-time {
      margin: 0;
      color: var(--color-gray-700);
      font-weight: 700;
      font-size: 0.82rem;
    }

    .program-presentation-authors,
    .program-presentation-contrib {
      margin: 0;
      color: var(--color-gray-700);
      font-size: 0.9rem;
    }

    .program-presentation-award {
      margin: 0.15rem 0;
    }

    .program-presentation-discussion {
      margin-top: 0.6rem;
    }


    /* STYLING COPIED FROM PAPERS PAGE */
    .paper-hero {
      max-width: 62rem;
      margin: 0 auto 2.5rem;
      padding: clamp(1.5rem, 4vw, 3.5rem);
      background: linear-gradient(135deg, #fffdf8 0%, #f4eee5 100%);
      border: 1px solid #e5ddd2;
      border-radius: 1.25rem;
      box-shadow: 0 1rem 2.5rem rgb(59 53 47 / 8%);
    }

    .paper-hero h1 {
      max-width: 52rem;
      margin: 0;
      font-size: clamp(1.65rem, 2.4vw, 2.25rem);
      line-height: 1.12;
      letter-spacing: -0.025em;
    }

    .paper-hero__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      margin-top: 1.25rem;
      color: var(--color-gray-700);
      font-size: 0.9rem;
    }

    .paper-hero__meta > span + span::before {
      content: "•";
      margin-right: 1rem;
      color: #c8bcae;
    }

    .paper-kicker {
      margin: 0 0 0.75rem;
      color: var(--color-accent);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .paper-hero__eyebrow {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid rgb(118 80 11 / 14%);
    }

    .paper-hero__eyebrow .paper-kicker {
      margin: 0;
    }

    .paper-section {
      max-width: 62rem;
      margin-left: auto;
      margin-right: auto;
      padding: 1.25rem 1.5rem;
      border: 1px solid #e5ddd2;
      border-radius: 0.75rem;
      background: #fff;
      box-shadow: 0 0.35rem 1.25rem rgb(59 53 47 / 4%);
      margin-bottom: 1rem;
    }
    /* End of STYLING COPIED FROM PAPERS PAGE */

    .paper-section h3 {
      margin: 0;
      font-size: 1rem;
      line-height: 1.3;
    }
  </style>
</PageLayout>
