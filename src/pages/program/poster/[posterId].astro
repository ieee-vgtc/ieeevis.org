---
import ProgramPeopleList from "../../../components/ProgramPeopleList.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import AuthGate from "../../../components/AuthGate.astro";
import AwardBadge from "../../../components/AwardBadge.astro";
import NewTabIndicator from "../../../components/NewTabIndicator.astro";
import { fetchAllPosters } from "../../../utils/paperData";

export async function getStaticPaths() {
  const posters = await fetchAllPosters();
  return posters.map((poster) => ({ params: { posterId: poster.id } }));
}

const posters = await fetchAllPosters();
const poster = posters.find((entry) => entry.id === Astro.params.posterId);

if (!poster) {
  return new Response(null, { status: 404 });
}

const frontmatter = {
  title: poster.title,
  active_nav: "Program",
  contact: "web@ieeevis.org",
};
---

<PageLayout frontmatter={frontmatter}>
  <div class="prose max-w-4xl">
    <h1>{poster.title}</h1>

    {poster.award && <AwardBadge award={poster.award} />}

    <div class="mb-6">
      <h2 class="text-lg font-semibold mb-2">Authors</h2>
      <p>
        <ProgramPeopleList people={poster.authors} />
      </p>
    </div>

    <div class="mb-6">
      <h2 class="text-lg font-semibold mb-2">Keywords</h2>
      <p>{poster.keywords?.join(", ") || "N/A"}</p>
    </div>

    <!-- pdf url download -->
    <div class="mb-6">
      <h2 class="text-lg font-semibold mb-2">PDF</h2>
      {
        poster.pdf_url ? (
          <AuthGate label="PDF">
            <a
              href={poster.pdf_url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-blue-600 hover:underline"
            >
              Poster PDF
              <NewTabIndicator />
            </a>
          </AuthGate>
        ) : (
          <p>PDF not available.</p>
        )
      }
    </div>

    <!-- <div class="mb-6">
      <h2 class="text-lg font-semibold mb-2">Abstract</h2>
      <p>{poster.abstract}</p>
    </div> -->
  </div>
</PageLayout>
