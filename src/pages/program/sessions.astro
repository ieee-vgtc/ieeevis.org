---
import PageLayout from "../../layouts/PageLayout.astro";
import sessionListData from "../../data/program_test/session_list.json";
import type { ProgramSessionList } from "../../types/program";
import { withBaseURL } from "../../utils/withBaseURL";
import { getProgramEventTypeLabel } from "../../utils/programEventTypeLabel";

const CONFERENCE_TIME_ZONE = "Europe/Vienna";

type SessionListItem = {
  id: string;
  eventSlug: string;
  title: string;
  eventTitle: string;
  eventType: string;
  eventTypeLabel: string;
  dayKey: string;
  room: string;
  chairs: string[];
  startISO: string;
  endISO: string;
  startMs: number;
  searchText: string;
};

const typeColors: Record<string, string> = {
  full: "#1C3160",
  short: "#FDBB30",
  panel: "#A20A35",
  workshop: "#f4a261",
  tutorial: "#A20A35",
  vis: "#FDBB30",
  poster: "#1C3160",
  invited: "#1C3160",
  visap: "#2672B9",
  challenges: "#2672B9",
  symposium: "#2672B9",
  associated: "#2672B9",
  meetup: "#A20A35",
  live: "#A20A35",
  application: "#F15722",
  memorial: "#FDBB30",
  supporter: "#FDBB30",
  keynote: "#FDBB30",
  capstone: "#FDBB30",
  industry: "#FDBB30",
};

function getDateParts(date: Date, timeZone: string) {
  const formatter = new Intl.DateTimeFormat("en-US", {
    timeZone,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
  const parts = formatter.formatToParts(date);
  const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
  return {
    year: map.year,
    month: map.month,
    day: map.day,
  };
}

function getConferenceDayKey(iso: string) {
  const date = new Date(iso);
  const parts = getDateParts(date, CONFERENCE_TIME_ZONE);
  return `${parts.year}-${parts.month}-${parts.day}`;
}

const dayWeekFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: CONFERENCE_TIME_ZONE,
  weekday: "long",
});

const dayDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: CONFERENCE_TIME_ZONE,
  month: "short",
  day: "numeric",
});

const sessionList = sessionListData as unknown as ProgramSessionList;

const sessions: SessionListItem[] = Object.values(sessionList)
  .flatMap((eventDefinition) =>
    eventDefinition.sessions.map((session) => {
      const eventType = eventDefinition.event_type || "other";
      const dayKey = getConferenceDayKey(session.time_start);
      const searchText = [
        session.title,
        eventDefinition.long_name,
        session.room_name,
        ...(session.chair || []),
      ]
        .join(" ")
        .toLowerCase();

      return {
        id: session.session_id,
        eventSlug: `${session.event_prefix}-${session.session_id}`,
        title: session.title,
        eventTitle: eventDefinition.long_name,
        eventType,
        eventTypeLabel: getProgramEventTypeLabel(eventType),
        dayKey,
        room: session.room_name,
        chairs: session.chair || [],
        startISO: session.time_start,
        endISO: session.time_end,
        startMs: Date.parse(session.time_start),
        searchText,
      };
    }),
  )
  .sort((a, b) => a.startMs - b.startMs);

const groupedSessions = new Map<string, SessionListItem[]>();

for (const session of sessions) {
  const daySessions = groupedSessions.get(session.dayKey) || [];
  daySessions.push(session);
  groupedSessions.set(session.dayKey, daySessions);
}

const dayGroups = Array.from(groupedSessions.entries())
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([dayKey, daySessions]) => {
    const sortedSessions = daySessions.sort((a, b) => a.startMs - b.startMs);
    const referenceDate = new Date(daySessions[0].startISO);
    return {
      dayKey,
      weekdayLabel: dayWeekFormatter.format(referenceDate),
      dateLabel: dayDateFormatter.format(referenceDate),
      sessions: sortedSessions,
    };
  });

const typeCounts = sessions.reduce<Record<string, number>>((acc, session) => {
  acc[session.eventType] = (acc[session.eventType] || 0) + 1;
  return acc;
}, {});

const sortedTypes = Object.keys(typeCounts).sort((a, b) => a.localeCompare(b));

const frontmatter = {
  title: "All Sessions",
  active_nav: "All Sessions",
  contact: "web@ieeevis.org",
  full_width: true,
};
---

<PageLayout frontmatter={frontmatter}>
  <section
    class="program-sessions"
    data-conference-timezone={CONFERENCE_TIME_ZONE}
    data-local-storage-key="program-sessions-timezone-mode"
  >
    <div class="sessions-toolbar">
      <div>
        <p class="sessions-title">Conference Sessions</p>
        <p class="sessions-subtitle">
          Grouped by conference days. Times are rendered in
          <span class="js-tz-description"> conference timezone </span>.
        </p>
      </div>

      <div class="sessions-controls">
        <label class="sessions-control">
          Timezone display
          <select id="timezone-mode" class="sessions-select">
            <option value="conference">Conference timezone</option>
            <option value="local">My local timezone</option>
            <option value="both">Conference and local</option>
          </select>
        </label>

        <label class="sessions-control">
          Day view
          <select id="day-filter" class="sessions-select">
            <option value="all">All conference days</option>
            {dayGroups.map((dayGroup) => (
              <option value={dayGroup.dayKey}>{dayGroup.weekdayLabel}, {dayGroup.dateLabel}</option>
            ))}
          </select>
        </label>

        <label class="sessions-control">
          Search sessions
          <input
            id="sessions-search"
            class="sessions-search"
            type="search"
            placeholder="Search title, room, event, chair"
            aria-label="Search sessions"
          />
        </label>
      </div>
    </div>

    <div class="sessions-filter-bar" role="toolbar" aria-label="Session type filters">
      <button
        class="sessions-filter-pill is-active"
        type="button"
        data-type-filter="all"
        style="--pill-color: #374151"
        aria-pressed="true"
      >
        <span>All</span>
        <span class="sessions-filter-count">{sessions.length}</span>
      </button>

      {sortedTypes.map((sessionType) => (
        <button
          class="sessions-filter-pill"
          type="button"
          data-type-filter={sessionType}
          style={`--pill-color: ${typeColors[sessionType] || "#6b7280"}`}
          aria-pressed="false"
        >
          <span>{getProgramEventTypeLabel(sessionType)}</span>
          <span class="sessions-filter-count">{typeCounts[sessionType]}</span>
        </button>
      ))}
    </div>

    <div class="sessions-day-list">
      {dayGroups.map((dayGroup) => (
        <section class="sessions-day" data-day-group-container data-day-group={dayGroup.dayKey}>
          <header class="sessions-day-header">
            <h2>{dayGroup.weekdayLabel}</h2>
            <p>{dayGroup.dateLabel}</p>
          </header>

          <div class="sessions-day-content" role="list" aria-label={`Sessions for ${dayGroup.weekdayLabel}, ${dayGroup.dateLabel}`}>
            {dayGroup.sessions.map((session) => (
              <button
                type="button"
                class="session-card"
                role="listitem"
                data-session-card
                data-session-href={withBaseURL(`/program/session/${session.eventSlug}`)}
                data-type={session.eventType}
                data-day-group={dayGroup.dayKey}
                data-search={session.searchText}
                data-start={session.startISO}
                data-end={session.endISO}
                style={`--session-accent: ${typeColors[session.eventType] || "#6b7280"}`}
              >
                <p class="session-card-time js-time-range"></p>

                <h3>{session.title}</h3>

                <p class="session-card-meta">
                  <span class="session-card-type">{session.eventTypeLabel}</span>
                  <span>{session.eventTitle}</span>
                </p>

                <p class="session-card-room">{session.room}</p>

                {
                  session.chairs.length > 0 && (
                    <p class="session-card-chair">Chair: {session.chairs.join(", ")}</p>
                  )
                }
              </button>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="sessions-empty-state" data-empty-state hidden>No sessions match your filters.</p>
  </section>

  <script>
    (() => {
      const root = document.querySelector(".program-sessions");
      if (!root) return;

      const conferenceTimeZone = root.getAttribute("data-conference-timezone") || "UTC";
      const localStorageKey = root.getAttribute("data-local-storage-key") || "program-sessions-timezone-mode";
      const localTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";

      const timezoneSelect = root.querySelector("#timezone-mode");
      const dayFilterSelect = root.querySelector("#day-filter");
      const searchInput = root.querySelector("#sessions-search");
      const timeRanges = Array.from(root.querySelectorAll<HTMLElement>(".js-time-range"));
      const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-session-card]"));
      const dayGroups = Array.from(root.querySelectorAll<HTMLElement>("[data-day-group-container]"));
      const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-type-filter]"));
      const sessionLinkButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-session-href]"));
      const tzDescription = root.querySelector<HTMLElement>(".js-tz-description");
      const emptyState = root.querySelector<HTMLElement>("[data-empty-state]");

      const ALL_FILTER = "all";
      let activeTypeFilter = ALL_FILTER;

      const isSameDayFormatter = (timeZone: string) =>
        new Intl.DateTimeFormat("en-CA", {
          timeZone,
          year: "numeric",
          month: "2-digit",
          day: "2-digit",
        });

      const timeFormatter = (timeZone: string) =>
        new Intl.DateTimeFormat("en-US", {
          timeZone,
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });

      const dateFormatter = (timeZone: string) =>
        new Intl.DateTimeFormat("en-US", {
          timeZone,
          weekday: "short",
          month: "short",
          day: "numeric",
        });

      const compactRange = (startDate: Date, endDate: Date, timeZone: string) => {
        const sameDay = isSameDayFormatter(timeZone).format(startDate) === isSameDayFormatter(timeZone).format(endDate);
        if (sameDay) {
          return `${timeFormatter(timeZone).format(startDate)} - ${timeFormatter(timeZone).format(endDate)}`;
        }
        return `${dateFormatter(timeZone).format(startDate)} ${timeFormatter(timeZone).format(startDate)} - ${dateFormatter(timeZone).format(endDate)} ${timeFormatter(timeZone).format(endDate)}`;
      };

      const getMode = () => {
        if (!(timezoneSelect instanceof HTMLSelectElement)) return "conference";
        return timezoneSelect.value || "conference";
      };

      const getSelectedDay = () => {
        if (!(dayFilterSelect instanceof HTMLSelectElement)) return "all";
        return dayFilterSelect.value || "all";
      };

      const formatRangeForMode = (startISO: string, endISO: string) => {
        const mode = getMode();
        const startDate = new Date(startISO);
        const endDate = new Date(endISO);
        const showConference = mode === "conference" || mode === "both";
        const showLocal = mode === "local" || mode === "both";
        const parts: string[] = [];

        if (showConference) {
          parts.push(compactRange(startDate, endDate, conferenceTimeZone));
        }
        if (showLocal) {
          const localRange = compactRange(startDate, endDate, localTimeZone);
          parts.push(showConference ? `Local: ${localRange}` : localRange);
        }

        return parts.join(" | ");
      };

      const refreshTimeRanges = () => {
        const mode = getMode();

        for (const node of timeRanges) {
          const startISO = node.parentElement?.getAttribute("data-start");
          const endISO = node.parentElement?.getAttribute("data-end");
          if (!startISO || !endISO) continue;
          node.textContent = formatRangeForMode(startISO, endISO);
        }

        if (tzDescription) {
          if (mode === "conference") {
            tzDescription.textContent = ` ${conferenceTimeZone} (${conferenceTimeZone}) `;
          } else if (mode === "local") {
            tzDescription.textContent = ` your local timezone (${localTimeZone}) `;
          } else {
            tzDescription.textContent = ` both ${conferenceTimeZone} and your local timezone (${localTimeZone}) `;
          }
        }
      };

      const refreshFilterButtonState = () => {
        for (const button of filterButtons) {
          const buttonType = button.getAttribute("data-type-filter");
          const isActive = buttonType !== null ? activeTypeFilter === buttonType : false;
          button.setAttribute("aria-pressed", String(isActive));
          button.classList.toggle("is-active", isActive);
        }
      };

      const applyFilters = () => {
        const selectedDay = getSelectedDay();
        const query =
          searchInput instanceof HTMLInputElement && searchInput.value ? searchInput.value.trim().toLowerCase() : "";

        for (const card of cards) {
          const type = card.getAttribute("data-type");
          const dayKey = card.getAttribute("data-day-group");
          const search = card.getAttribute("data-search") || "";
          const typeMatch = activeTypeFilter === ALL_FILTER || (type !== null && activeTypeFilter === type);
          const dayMatch = selectedDay === "all" || dayKey === selectedDay;
          const textMatch = query.length === 0 || search.includes(query);
          card.hidden = !(typeMatch && textMatch && dayMatch);
        }

        let visibleTotal = 0;
        for (const group of dayGroups) {
          const visibleCards = group.querySelectorAll("[data-session-card]:not([hidden])");
          group.hidden = visibleCards.length === 0;
          visibleTotal += visibleCards.length;
        }

        if (emptyState) {
          emptyState.hidden = visibleTotal !== 0;
        }
      };

      for (const button of filterButtons) {
        button.addEventListener("click", () => {
          const buttonType = button.getAttribute("data-type-filter");
          if (!buttonType) return;
          activeTypeFilter = buttonType;
          refreshFilterButtonState();
          applyFilters();
        });
      }

      if (searchInput instanceof HTMLInputElement) {
        searchInput.addEventListener("input", () => {
          applyFilters();
        });
      }

      if (timezoneSelect instanceof HTMLSelectElement) {
        const savedMode = localStorage.getItem(localStorageKey);
        if (savedMode === "conference" || savedMode === "local" || savedMode === "both") {
          timezoneSelect.value = savedMode;
        }

        timezoneSelect.addEventListener("change", () => {
          localStorage.setItem(localStorageKey, timezoneSelect.value);
          refreshTimeRanges();
        });
      }

      if (dayFilterSelect instanceof HTMLSelectElement) {
        dayFilterSelect.addEventListener("change", () => {
          applyFilters();
        });
      }

      for (const button of sessionLinkButtons) {
        button.addEventListener("click", () => {
          const href = button.getAttribute("data-session-href");
          if (href) {
            window.location.href = href;
          }
        });
      }

      // Pre-apply type filter from URL param (?type=full, etc.)
      const urlTypeParam = new URLSearchParams(location.search).get("type");
      if (urlTypeParam && filterButtons.some((b) => b.getAttribute("data-type-filter") === urlTypeParam)) {
        activeTypeFilter = urlTypeParam;
      }

      refreshFilterButtonState();
      refreshTimeRanges();
      applyFilters();
    })();
  </script>

  <style>
    .program-sessions {
      display: grid;
      gap: 1rem;
    }

    .sessions-toolbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem;
      border: 1px solid var(--color-gray-300);
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(223, 104, 36, 0.08), rgba(187, 74, 114, 0.08));
    }

    .sessions-title {
      margin: 0;
      font-weight: 700;
      color: var(--color-accent);
    }

    .sessions-subtitle {
      margin: 0.3rem 0 0;
      color: var(--color-gray-700);
      font-size: 0.95rem;
    }

    .sessions-controls {
      display: grid;
      grid-template-columns: repeat(3, minmax(180px, 260px));
      gap: 0.8rem;
      align-items: end;
    }

    .sessions-control {
      display: grid;
      gap: 0.3rem;
      font-size: 0.85rem;
      color: var(--color-gray-700);
      font-weight: 600;
    }

    .sessions-select,
    .sessions-search {
      width: 100%;
      border: 1px solid var(--color-gray-400);
      border-radius: 8px;
      padding: 0.45rem 0.6rem;
      background-color: white;
      font-size: 0.95rem;
      color: var(--color-gray-900);
    }

    .sessions-filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .sessions-filter-pill {
      border: 1px solid var(--pill-color);
      color: var(--pill-color);
      background: white;
      border-radius: 999px;
      padding: 0.3rem 0.75rem;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      cursor: pointer;
      transition: all 120ms ease;
    }

    .sessions-filter-pill:hover {
      transform: translateY(-1px);
    }

    .sessions-filter-pill.is-active {
      color: white;
      background: var(--pill-color);
    }

    .sessions-filter-count {
      font-weight: 700;
      opacity: 0.9;
    }

    .sessions-day-list {
      display: grid;
      gap: 0.9rem;
    }

    .sessions-day {
      border: 1px solid var(--color-gray-300);
      border-radius: 10px;
      background: white;
      min-width: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .sessions-day-header {
      border-bottom: 1px solid var(--color-gray-300);
      padding: 0.85rem 1rem;
      background: #fafafa;
    }

    .sessions-day-header h2 {
      margin: 0;
      font-size: 1rem;
      color: var(--color-accent);
    }

    .sessions-day-header p {
      margin: 0.2rem 0 0;
      color: var(--color-gray-700);
      font-size: 0.9rem;
    }

    .sessions-day-content {
      display: grid;
      gap: 0.65rem;
      padding: 0.75rem;
      align-content: start;
    }

    .session-card {
      appearance: none;
      font: inherit;
      text-align: left;
      cursor: pointer;
      border: 1px solid var(--color-gray-300);
      border-left: 4px solid var(--session-accent);
      border-radius: 8px;
      padding: 0.75rem;
      background: #fff;
      display: grid;
      gap: 0.35rem;
      color: inherit;
      text-decoration: none;
      transition: transform 90ms ease, box-shadow 90ms ease;
    }

    .session-card:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

    .session-card:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--session-accent), #17325f 35%);
      outline-offset: 0;
    }

    .session-card-time {
      margin: 0;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-gray-700);
    }

    .session-card h3 {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.3;
      color: var(--color-gray-900);
    }

    .session-card-meta,
    .session-card-room,
    .session-card-chair {
      margin: 0;
      font-size: 0.86rem;
      color: var(--color-gray-700);
    }

    .session-card-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      align-items: center;
    }

    .session-card-type {
      display: inline-block;
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      font-weight: 800;
      color: var(--session-accent);
    }

    .sessions-empty-state {
      margin: 0;
      border: 1px dashed var(--color-gray-400);
      border-radius: 10px;
      padding: 1rem;
      color: var(--color-gray-700);
      background: #fcfcfc;
      text-align: center;
      font-weight: 600;
    }

    @media (max-width: 900px) {
      .sessions-controls {
        grid-template-columns: 1fr;
        width: 100%;
      }
    }
  </style>
</PageLayout>
