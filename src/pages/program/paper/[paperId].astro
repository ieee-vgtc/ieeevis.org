---
import PageLayout from "../../../layouts/PageLayout.astro";
import AuthGate from "../../../components/AuthGate.astro";
import BlueskyDiscussion from "../../../components/BlueskyDiscussion";
import { fetchAllPapers } from "../../../utils/paperData";
import { features } from "../../../config/pages-allow-list";
import { withBaseURL } from "../../../utils/withBaseURL";
import { ogDescription } from "../../../utils/ogDescription";
import { fetchAllSessions } from "../../../utils/paperData";
import { buildLoginUrl, readSession } from "../../../lib/auth0";
import type { Paper } from "../../../types/paper";
import type { ProgramSession, ProgramTimeSlot } from "../../../types/program";

// Rendered on request (Netlify) so each request can check the signed-in
// session. The S3 deploys are static files only, so their workflows set
// STATIC_PROGRAM_PAGES=true, which prerenders this page instead (see
// astro.config.mjs); there the gated content always shows the login prompt.
export const prerender = false;

// Only used when STATIC_PROGRAM_PAGES prerenders this page.
export async function getStaticPaths() {
  const papers = await fetchAllPapers();
  return papers.map((paper) => ({ params: { paperId: paper.id } }));
}

const EVENT_PREFIX_LABELS: Record<string, string> = {
  "v-full": "VIS Full Papers",
  "v-short": "VIS Short Papers",
  "a-visap": "VISAP",
  "v-tvcg": "TVCG Papers",
};

// Maps event_prefix to the event_type used by sessions.astro filter pills
const EVENT_PREFIX_TO_TYPE: Record<string, string> = {
  "v-full": "full",
  "v-short": "short",
  "a-visap": "visap",
  "v-tvcg": "tvcg",
};

if (!features.weekOfVis.enabled) {
  return new Response(null, { status: 404 });
}

// Static S3 builds have no request cookies; on Netlify this route is rendered
// per request and can resolve the attendee session normally.
const user =
  process.env.STATIC_PROGRAM_PAGES === "true"
    ? undefined
    : await readSession(Astro.cookies, Astro.url);
const isAuthenticated = Boolean(user);
const loginHref = buildLoginUrl(Astro.url);

// Detail pages are rendered at request time (not prerendered) so each
// request can be checked for a signed-in session before deciding whether
// to render the paper's PDF link and video embed, or a login prompt.
const [sessionList, papers] = await Promise.all([
  fetchAllSessions(),
  fetchAllPapers(),
]);
const sourcePaper = papers.find((entry) => entry.id === Astro.params.paperId);

if (!sourcePaper) {
  return new Response(null, { status: 404 });
}

const paperEvent = Object.values(sessionList).find(
  (event) => event.event_prefix === sourcePaper.event_prefix,
);

// Find the slot presenting this paper (slot.uid = paper.id UUID).
let presentation:
  { session: ProgramSession; slot: ProgramTimeSlot } | undefined;
for (const event of Object.values(sessionList)) {
  for (const session of event.sessions) {
    const slot = session.time_slots.find(
      (entry) => entry.uid === sourcePaper.id,
    );
    if (slot) presentation = { session, slot };
  }
}

const paper: Paper = {
  ...sourcePaper,
  ...(presentation && {
    session_id: presentation.session.session_id,
    session_title: presentation.session.title,
    session_room: presentation.session.room_name,
    time_stamp: presentation.slot.time_start,
  }),
};

const supplementalLink = paper.open_access_supplemental_link?.trim()
  ? /^https?:\/\//i.test(paper.open_access_supplemental_link.trim())
    ? paper.open_access_supplemental_link.trim()
    : `https://${paper.open_access_supplemental_link.trim().replace(/^\/\//, "")}`
  : null;

const sessionHref =
  presentation &&
  withBaseURL(
    `/program/session/${presentation.session.event_prefix}-${presentation.session.session_id}`,
  );

const CONFERENCE_TIME_ZONE = "US/Eastern";
const presentationDateFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: CONFERENCE_TIME_ZONE,
  weekday: "long",
  month: "short",
  day: "numeric",
});
const presentationTimeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: CONFERENCE_TIME_ZONE,
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});
const formatTimeRange = (startISO: string, endISO: string) =>
  `${presentationTimeFormatter.format(new Date(startISO))} – ${presentationTimeFormatter.format(new Date(endISO))}`;

const presentationDetails = presentation && {
  date: presentationDateFormatter.format(
    new Date(presentation.slot.time_start || presentation.session.time_start),
  ),
  talkTime: formatTimeRange(
    presentation.slot.time_start || presentation.session.time_start,
    presentation.slot.time_end || presentation.session.time_end,
  ),
  sessionTime: formatTimeRange(
    presentation.session.time_start,
    presentation.session.time_end,
  ),
  room: presentation.session.room_name || "TBA",
  // e.g. "Satellite (Paris)" or "Pre-recorded"; "Premise" is in person.
  mode:
    presentation.slot.presentation_mode &&
    presentation.slot.presentation_mode !== "Premise"
      ? presentation.slot.presentation_mode
      : null,
};

// Breadcrumb data
const eventLabel =
  paper.event_title ||
  paperEvent?.event ||
  paperEvent?.long_name ||
  EVENT_PREFIX_LABELS[paper.event_prefix] ||
  paper.event_prefix;
// Workshop events have their own session page. Other event categories link to
// the sessions page pre-filtered by event type.
const eventType =
  paperEvent?.event_type ||
  EVENT_PREFIX_TO_TYPE[paper.event_prefix] ||
  paper.event_prefix;
const workshopSession =
  eventType === "workshop" ? paperEvent?.sessions[0] : undefined;
const eventUrl = workshopSession
  ? withBaseURL(
      `/program/session/${workshopSession.event_prefix}-${workshopSession.session_id}`,
    )
  : withBaseURL(`/program/sessions/?type=${encodeURIComponent(eventType)}`);

const awardLabel =
  paper.award === "best"
    ? "\uD83C\uDFC6 Best Paper Award"
    : "\uD83C\uDF96\uFE0F Honorable Mention";

// Video embeds are on hold until session_youtube_url / session_bunny_prerecorded_link
// (etc.) are actually populated in the paper data. Re-enable this alongside the
// "Video" section and .video-embed styles below once that data is available.
// function youtubeEmbedUrl(idOrUrl: string): string {
//   try {
//     const url = new URL(idOrUrl);
//     if (url.hostname.includes("youtu.be")) {
//       return `https://www.youtube.com/embed/${url.pathname.slice(1)}`;
//     }
//     const id = url.searchParams.get("v");
//     if (id) return `https://www.youtube.com/embed/${id}`;
//     if (url.pathname.startsWith("/embed/")) return url.toString();
//   } catch {
//     // Not a URL - treat the input as a bare video ID.
//   }
//   return `https://www.youtube.com/embed/${idOrUrl}`;
// }
//
// const videoEmbedUrl =
//   (paper.session_youtube_url && youtubeEmbedUrl(paper.session_youtube_url)) ||
//   (paper.session_youtube_prerecorded_id &&
//     youtubeEmbedUrl(paper.session_youtube_prerecorded_id)) ||
//   paper.session_bunny_prerecorded_link ||
//   (paper.session_youtube_ff_id &&
//     youtubeEmbedUrl(paper.session_youtube_ff_id)) ||
//   paper.session_bunny_ff_link ||
//   null;

// Social-card description: a clean snippet of the abstract, falling back to
// authors + venue when no abstract is available so the card is never empty.
const authorNames = paper.authors.map((a) => a.name).join(", ");
const venue = paper.session_title
  ? `${eventLabel} · ${paper.session_title}`
  : eventLabel;
const ogDesc =
  ogDescription(paper.abstract) ||
  ogDescription(
    [authorNames, venue].filter(Boolean).join(" — ") ||
      "A paper presented at IEEE VIS 2026.",
  );

const frontmatter = {
  title: paper.title,
  description: ogDesc,
  ogType: "article",
  ogImageAlt: `Social card for the IEEE VIS 2026 paper “${paper.title}”.`,
  active_nav: "Program",
  contact: "web@ieeevis.org",
};
---

<PageLayout frontmatter={frontmatter}>
  <div class="prose max-w-4xl">
    <!-- Breadcrumb navigation with bookmark at end -->
    <nav class="breadcrumb not-prose" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li class="breadcrumb__item">
          <a href={eventUrl} class="breadcrumb__link">{eventLabel}</a>
        </li>

        {
          paper.session_title && paper.session_id && (
            <>
              <li class="breadcrumb__sep" aria-hidden="true">
                ›
              </li>
              <li class="breadcrumb__item">
                <a href={sessionHref} class="breadcrumb__link">
                  {paper.session_title}
                </a>
              </li>
            </>
          )
        }

        <li class="breadcrumb__sep" aria-hidden="true">›</li>
        <li
          class="breadcrumb__item breadcrumb__item--current"
          aria-current="page"
        >
          <span class="breadcrumb__current">{paper.title}</span>
        </li>
      </ol>

      <!-- Bookmark icon button at the end of the breadcrumb row -->
      <button
        id="bookmarkBtn"
        class="bookmark-icon-btn"
        data-paper-id={paper.id}
        aria-label="Bookmark this paper"
        title="Bookmark this paper"
      >
        <svg
          id="bookmark-icon-empty"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
        <svg
          id="bookmark-icon-filled"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="2"
          style="display:none"
        >
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
        </svg>
      </button>
    </nav>

    <h1>{paper.title}</h1>

    <!-- Award badge -->
    {paper.award && <p class="award-badge not-prose">{awardLabel}</p>}

    <!-- Authors -->
    <div class="mb-6">
      <h2>Authors</h2>
      <p>
        {
          paper.authors.map((a, idx) => {
            return (
              <span>
                <a
                  href={withBaseURL(
                    `/program/papers/?search=${encodeURIComponent(a.name)}`,
                  )}
                  class="text-accent underline decoration-accent-200 decoration-dotted underline-offset-3 hover:text-accent-700 focus-visible:text-accent-700"
                >
                  {a.name}
                </a>
                {a.affiliation && <span>{` (${a.affiliation})`}</span>}
                {idx < paper.authors.length - 1 ? ", " : ""}
              </span>
            );
          })
        }
      </p>
    </div>

    <!-- Presentation: session, time, and location -->
    {
      presentation && presentationDetails && (
        <div class="mb-6">
          <h2>Presentation</h2>
          <dl class="presentation-details">
            <dt>Session</dt>
            <dd>
              <a href={sessionHref}>{presentation.session.title}</a>
            </dd>
            <dt>Time</dt>
            <dd>
              {`${presentationDetails.date}, ${presentationDetails.talkTime} (${CONFERENCE_TIME_ZONE})`}
              {presentationDetails.talkTime !==
                presentationDetails.sessionTime && (
                <span class="presentation-details__note">
                  {" "}
                  · session {presentationDetails.sessionTime}
                </span>
              )}
            </dd>
            <dt>Location</dt>
            <dd>
              {presentationDetails.room}
              {presentationDetails.mode && (
                <span class="presentation-details__note">
                  {" "}
                  · {presentationDetails.mode}
                </span>
              )}
            </dd>
          </dl>
        </div>
      )
    }

    <!-- Links (immediately after authors, styled as plain inline links matching authors) -->
    {
      (paper.preprint_link ||
        paper.doi ||
        supplementalLink) && (
        <div class="paper-links mb-6">
          <h2>Links</h2>
          <ul>
            {paper.preprint_link && (
              <li>
                <AuthGate
                  isAuthenticated={isAuthenticated}
                  loginHref={loginHref}
                  label="preprint PDF"
                >
                  <a
                    href={paper.preprint_link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Download preprint PDF
                  </a>
                </AuthGate>
              </li>
            )}
            {supplementalLink && (
              <li>
                <a
                  href={supplementalLink}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Download Supplemental Material
                </a>
              </li>
            )}
            {paper.doi && (
              <li>
                <a
                  href={`https://doi.org/${paper.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  DOI: {paper.doi}
                </a>
              </li>
            )}
          </ul>
        </div>
      )
    }

    <!-- Video: commented out until session_youtube_url / session_bunny_prerecorded_link
         data is populated (see the matching comment in the frontmatter above). -->
    <!--
    {
      videoEmbedUrl && (
        <div class="mb-6">
          <h2>Video</h2>
          <AuthGate
            isAuthenticated={isAuthenticated}
            loginHref={loginHref}
            label="video"
          >
            <div class="video-embed not-prose">
              <iframe
                src={videoEmbedUrl}
                title={`Video for ${paper.title}`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          </AuthGate>
        </div>
      )
    }
    -->

    <!-- Keywords -->
    {
      paper.keywords.length > 0 && (
        <div class="mb-6">
          <h2>Keywords</h2>
          <p>{paper.keywords?.join(", ") || "N/A"}</p>
        </div>
      )
    }

    <!-- Abstract -->
    <div class="mb-6">
      <h2>Abstract</h2>
      <p>{paper.abstract || "TBD"}</p>
    </div>

    <!-- For Practitioners -->
    {
      paper.practitioners_statement && (
        <div class="mb-6">
          <h2>For Practitioners</h2>
          <p>{paper.practitioners_statement}</p>
        </div>
      )
    }

    <!-- Bluesky discussion: thread of replies to this paper's announcement
         post, proxied through bsky.tech.ieeevis.org so it loads on any
         conference network. Sortable by upvotes or recency. -->
    <div class="mb-6 not-prose">
      <BlueskyDiscussion client:visible paperId={paper.id} />
    </div>
  </div>
</PageLayout>

<script>
  const btn = document.getElementById(
    "bookmarkBtn",
  ) as HTMLButtonElement | null;
  const iconEmpty = document.getElementById("bookmark-icon-empty");
  const iconFilled = document.getElementById("bookmark-icon-filled");
  const paperId = btn?.dataset.paperId;

  // Must match ProgramPapersBrowser's default storageKeyPrefix "program-papers"
  const STORAGE_KEY = "program-papers-bookmarks";

  function getBookmarks(): string[] {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
    } catch {
      return [];
    }
  }

  function updateBtn() {
    if (!btn || !paperId) return;
    const bookmarked = getBookmarks().includes(paperId);
    btn.classList.toggle("bookmarked", bookmarked);
    btn.setAttribute(
      "aria-label",
      bookmarked ? "Remove bookmark" : "Bookmark this paper",
    );
    btn.setAttribute(
      "title",
      bookmarked ? "Remove bookmark" : "Bookmark this paper",
    );
    if (iconEmpty) iconEmpty.style.display = bookmarked ? "none" : "";
    if (iconFilled) iconFilled.style.display = bookmarked ? "" : "none";
  }

  btn?.addEventListener("click", () => {
    if (!paperId) return;
    const bookmarks = getBookmarks();
    const idx = bookmarks.indexOf(paperId);
    if (idx === -1) {
      bookmarks.push(paperId);
    } else {
      bookmarks.splice(idx, 1);
    }
    localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks));
    updateBtn();
  });

  updateBtn();
</script>

<style>
  /* Presentation details */
  .presentation-details {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 1rem;
    row-gap: 0.25rem;
    margin: 0;
  }

  .presentation-details dt {
    margin: 0;
    font-weight: 700;
  }

  .presentation-details dd {
    margin: 0;
    padding: 0;
  }

  .presentation-details__note {
    color: var(--color-gray-700);
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.75rem 0;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #dee2e6;
    font-size: 0.875rem;
  }

  .breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .breadcrumb__sep {
    color: #adb5bd;
    user-select: none;
  }

  .breadcrumb__link {
    color: var(--color-accent);
    text-decoration: none;
  }

  .breadcrumb__link:visited {
    color: var(--color-primary-800);
  }

  .breadcrumb__link:hover {
    text-decoration: underline;
  }

  .breadcrumb__current {
    color: #555;
    /* Truncate long titles in the breadcrumb */
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-width: 30ch;
  }

  /* Bookmark icon button */
  .bookmark-icon-btn {
    flex-shrink: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem;
    color: #adb5bd;
    line-height: 0;
    transition: color 0.15s;
    align-self: center;
  }

  .bookmark-icon-btn:hover {
    color: var(--color-accent);
  }

  .bookmark-icon-btn.bookmarked {
    color: var(--color-accent);
  }

  /* Award badge */
  .award-badge {
    display: inline-block;
    background: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 4px;
    padding: 0.3rem 0.75rem;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }

  /* Links section - styled as prose, plain inline links */
  .paper-links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .paper-links a:visited {
    color: var(--color-primary-800);
  }

  .paper-links a:hover {
    text-decoration: underline;
  }

  /* Video embed - responsive 16:9 (unused while the Video section above is
     commented out; kept ready for when it's re-enabled) */
  /*
  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 6px;
  }
  */
</style>
