---
// export const prerender = false;

import PageLayout from "../../layouts/PageLayout.astro";
import { fetchAllPapers, fetchAllSessions } from "../../utils/paperData";
import { withBaseURL } from "../../utils/withBaseURL";
import ProgramPapersBrowser from "../../components/ProgramPapersBrowser.astro";
import type { ProgramTimeSlot } from "../../types/program";
import type {
  ProgramPaperCard,
  ProgramSessionRole,
} from "../../types/programPaper";
import { getProgramEventTypeLabel } from "../../utils/programEventTypeLabel";

const CONFERENCE_TIME_ZONE = "US/Eastern";

type PaperSessionMeta = {
  sessionSlug: string;
  sessionTitle: string;
  roomName: string;
  eventTitle: string;
  startISO: string;
  endISO: string;
  startMs: number;
};

const conferenceDateTimeFormatter = new Intl.DateTimeFormat("en-US", {
  timeZone: CONFERENCE_TIME_ZONE,
  weekday: "short",
  month: "short",
  day: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
});

const normalizeText = (value: string | null | undefined) =>
  (value || "").trim();

const getPaperTypeFromEvent = (eventName: string, eventType: string) => {
  const normalizedEventName = normalizeText(eventName).toLowerCase();

  if (normalizedEventName.includes("tvcg")) {
    return "tvcg";
  }
  if (
    normalizedEventName.includes("cg&a") ||
    normalizedEventName.includes("computer graphics & applications")
  ) {
    return "cg&a";
  }

  return normalizeText(eventType) || "Other";
};

const getPaperLabelFromEvent = (eventName: string, paperType: string) => {
  const normalizedEventName = normalizeText(eventName);

  if (paperType === "workshop" && normalizedEventName) {
    return /\bworkshop\b/i.test(normalizedEventName)
      ? `${normalizedEventName} Paper`
      : `${normalizedEventName} Workshop Paper`;
  }

  return getProgramEventTypeLabel(paperType);
};

const slotMetadataByPaperId = new Map<string, PaperSessionMeta>();
const sessionList = await fetchAllSessions();
const paperEventByPrefix = new Map(
  Object.values(sessionList).map((event) => {
    const type = getPaperTypeFromEvent(event.event, event.event_type);
    const soleSession = event.sessions.length === 1 ? event.sessions[0] : null;
    return [
      event.event_prefix,
      {
        type,
        label: getPaperLabelFromEvent(event.event, type),
        eventLabel: event.long_name || event.event,
        soleSession: soleSession
          ? {
              sessionSlug: `${soleSession.event_prefix}-${soleSession.session_id}`,
              sessionTitle: soleSession.title,
              roomName: soleSession.room_name,
              eventTitle: event.long_name,
              startISO: soleSession.time_start,
              endISO: soleSession.time_end,
              startMs: Date.parse(soleSession.time_start),
            }
          : null,
      },
    ];
  }),
);

for (const event of Object.values(sessionList)) {
  for (const session of event.sessions) {
    const sessionSlug = `${session.event_prefix}-${session.session_id}`;
    for (const slot of session.time_slots as ProgramTimeSlot[]) {
      if (!slot.uid) {
        continue;
      }

      const slotStart = slot.time_start || session.time_start;
      const slotEnd = slot.time_end || session.time_end;
      slotMetadataByPaperId.set(slot.uid, {
        sessionSlug,
        sessionTitle: session.title,
        roomName: session.room_name,
        eventTitle: event.long_name,
        startISO: slotStart,
        endISO: slotEnd,
        startMs: Date.parse(slotStart),
      });
    }
  }
}

const papers = await fetchAllPapers();

const paperCards: ProgramPaperCard[] = papers.map((paper) => {
  const linkedSlot = slotMetadataByPaperId.get(paper.id);
  const paperEvent = paperEventByPrefix.get(paper.event_prefix);
  const resolvedSession = linkedSlot || paperEvent?.soleSession || null;
  const authors = (paper.authors || [])
    .map((author) => normalizeText(author.name))
    .filter(Boolean);
  const keywords = (paper.keywords || [])
    .map((keyword) => normalizeText(keyword))
    .filter(Boolean);

  const startISO = resolvedSession?.startISO || null;
  const presentationType = paperEvent?.type || "VIS Paper";
  const presentationLabel =
    paperEvent?.label || getProgramEventTypeLabel(presentationType);
  const sessionLabel = resolvedSession?.sessionTitle || "Session TBA";
  const scheduleLabel = startISO
    ? `${conferenceDateTimeFormatter.format(new Date(startISO))} - ${sessionLabel}`
    : sessionLabel;

  return {
    id: paper.id,
    title: normalizeText(paper.title) || "Untitled submission",
    authorNames: authors,
    keywordsLabel:
      keywords.length > 0 ? keywords.join(", ") : "No keywords listed",
    abstractText: normalizeText(paper.abstract) || "Abstract not available.",
    presentationType,
    presentationLabel,
    eventKey: normalizeText(paper.event_prefix) || null,
    eventLabel: paperEvent?.eventLabel || presentationLabel,
    sessionKey: resolvedSession?.sessionSlug || null,
    sessionLabel,
    scheduleLabel,
    startMs:
      resolvedSession?.startMs && Number.isFinite(resolvedSession.startMs)
        ? resolvedSession.startMs
        : Number.MAX_SAFE_INTEGER,
    doiUrl: paper.doi ? `https://doi.org/${paper.doi}` : null,
    preprintUrl: normalizeText(paper.preprint_link) || null,
    supplementalUrl: normalizeText(paper.open_access_supplemental_link) || null,
    sessionUrl: resolvedSession?.sessionSlug
      ? withBaseURL(`/program/session/${resolvedSession.sessionSlug}`)
      : null,
    award: normalizeText(paper.award) || null,
    // Earlier years mark TVCG papers with their own event; newer data only
    // marks them via a TVCG-prefixed program paper id.
    isTvcg:
      paper.event_prefix === "v-tvcg" ||
      /^tvcg/i.test(normalizeText(paper.program_paper_id)),
  };
});

// Keynote and capstone talks have no paper page, but people should still find
// them by searching for the speaker. Each one is simulcast to several rooms, so
// keep one card per talk.
const invitedTalkKinds = [
  {
    word: "keynote",
    label: "Keynote",
    href: "/info/invited-speakers/keynote-speaker",
  },
  {
    word: "capstone",
    label: "Capstone",
    href: "/info/invited-speakers/capstone-speaker",
  },
  {
    word: "visions",
    label: "VISions Talk",
    href: "/info/invited-speakers/visions",
  },
];
const invitedTalkCards = new Map<string, ProgramPaperCard>();

for (const event of Object.values(sessionList)) {
  for (const session of event.sessions) {
    for (const slot of session.time_slots as ProgramTimeSlot[]) {
      const speakers = (slot.contributors || []).filter(Boolean);
      // Match at word starts so e.g. "Revisions" is not a VISions talk.
      const kind = invitedTalkKinds.find((candidate) =>
        new RegExp(`\\b${candidate.word}`, "i").test(
          `${slot.title} ${session.session_id}`,
        ),
      );
      if (!kind) {
        continue;
      }
      // VISions talks have paper records, so relabel those cards instead.
      if (slot.uid) {
        const paperCard = paperCards.find((card) => card.id === slot.uid);
        if (paperCard) {
          paperCard.presentationType = "invited-talk";
          paperCard.presentationLabel = getProgramEventTypeLabel("invited-talk");
          paperCard.eyebrow = kind.label;
        }
        continue;
      }
      if (speakers.length === 0) {
        continue;
      }

      // Slots named only "Keynote" or "Capstone" get the speaker's name.
      const title =
        slot.title.toLowerCase() === kind.word
          ? `${kind.label} by ${speakers.join(", ")}`
          : slot.title;
      const key = `${title}|${slot.time_start}`;
      if (invitedTalkCards.has(key)) {
        continue;
      }

      const sessionSlug = `${session.event_prefix}-${session.session_id}`;
      invitedTalkCards.set(key, {
        id: slot.slot_id,
        title,
        authorNames: speakers,
        keywordsLabel: "",
        abstractText: "",
        presentationType: "invited-talk",
        presentationLabel: getProgramEventTypeLabel("invited-talk"),
        eventKey: event.event_prefix,
        eventLabel: event.long_name,
        sessionKey: sessionSlug,
        sessionLabel: session.title,
        scheduleLabel: `${conferenceDateTimeFormatter.format(new Date(slot.time_start))} - ${session.title}`,
        startMs: Date.parse(slot.time_start),
        doiUrl: null,
        preprintUrl: null,
        supplementalUrl: null,
        sessionUrl: withBaseURL(`/program/session/${sessionSlug}`),
        award: null,
        eyebrow: kind.label,
        titleHref: kind.href,
      });
    }
  }
}

paperCards.push(...invitedTalkCards.values());

// Events run by organizers rather than session chairs (see sessions.astro).
const organizerEventTypes = ["workshop", "tutorial", "associated", "challenge"];
const organizerRoleLabels: Record<string, string> = {
  workshop: "Workshop Organizer",
  tutorial: "Tutorial Organizer",
  associated: "Associated Event Organizer",
  challenge: "Contest Organizer",
};

const sessionRoles: ProgramSessionRole[] = Object.values(sessionList)
  .flatMap((event) =>
    event.sessions.flatMap((session) => {
      const eventType = event.event_type.toLowerCase();
      const usesOrganizers =
        organizerEventTypes.includes(eventType) &&
        event.organizers.length > 0;
      const people = usesOrganizers ? event.organizers : session.chair || [];
      if (people.length === 0) {
        return [];
      }
      return [
        {
          role: usesOrganizers ? ("Organizer" as const) : ("Chair" as const),
          roleLabel: usesOrganizers
            ? organizerRoleLabels[eventType]
            : "Session Chair",
          people,
          sessionTitle: session.title,
          sessionUrl: withBaseURL(
            `/program/session/${session.event_prefix}-${session.session_id}`,
          ),
          scheduleLabel: session.time_start
            ? conferenceDateTimeFormatter.format(new Date(session.time_start))
            : "Time TBA",
          roomName: session.room_name,
          startMs: Date.parse(session.time_start),
        },
      ];
    }),
  )
  .sort((a, b) => a.startMs - b.startMs);

const frontmatter = {
  title: "Papers",
  active_nav: "Accepted Papers",
  contact: "web@ieeevis.org",
  full_width: true,
};
---

<PageLayout frontmatter={frontmatter}>
  <ProgramPapersBrowser
    papers={paperCards}
    sessionRoles={sessionRoles}
    itemType="paper"
  />
</PageLayout>
