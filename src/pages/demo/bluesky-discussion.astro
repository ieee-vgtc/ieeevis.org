---
import PageLayout from "../../layouts/PageLayout.astro";
import BlueskyDiscussion from "../../components/BlueskyDiscussion";

const frontmatter = {
  title: "Bluesky Discussion Demo",
  active_nav: "Program",
  contact: "web@ieeevis.org",
};
---

<PageLayout frontmatter={frontmatter}>
  <p>
    This page demonstrates the paper-page discussion embed,
    <code>src/components/BlueskyDiscussion.tsx</code>. Paper pages pass the
    paper's id; the discussion service resolves it to the announcement post and
    its reply thread.
  </p>

  <p class="demo-auth-note" role="note" data-signed-in hidden>
    You are signed in, so the service-backed example below accepts comments
    and likes as a VIS attendee. Log in with Bluesky under either
    announcement to post from your own account instead.
  </p>
  <p class="demo-auth-note" role="note" data-signed-out>
    Commenting as a VIS attendee needs an Auth0 sign-in — <code
      >/auth/token</code
    > mints the token the discussion service checks.
    <button type="button" data-sign-in>Sign in</button> to try it. Logging in
    with Bluesky under either announcement works without one: comments and
    likes then come from your own Bluesky account.
  </p>

  <style>
    .demo-auth-note {
      padding: 0.75rem 1rem;
      border: 1px dashed var(--color-gray-400, #ced4da);
      border-radius: 6px;
      background: var(--color-gray-100, #f8f9fa);
      color: var(--color-gray-800, #495057);
      font-size: 0.9rem;
    }

    .demo-auth-note button {
      color: inherit;
      background: none;
      border: none;
      padding: 0;
      font: inherit;
      text-decoration: underline;
      cursor: pointer;
    }
  </style>

  <script>
    import { currentPagePath, getCurrentUser, login } from "../../lib/auth0Client";

    getCurrentUser().then((user) => {
      document
        .querySelector<HTMLElement>("[data-signed-in]")
        ?.toggleAttribute("hidden", !user);
      document
        .querySelector<HTMLElement>("[data-signed-out]")
        ?.toggleAttribute("hidden", Boolean(user));
    });

    document.querySelector("[data-sign-in]")?.addEventListener("click", () => {
      login(currentPagePath()).catch((error: unknown) => {
        console.error("Unable to start Auth0 login:", error);
      });
    });
  </script>

  <h2>By paper id (service)</h2>
  <p>
    Resolves <code>test-bsky-9999</code> through the discussion service. Shows
    the "discussion opens…" state until the test announcement has been posted.
  </p>
  <BlueskyDiscussion paperId="test-bsky-9999" client:load />

  <h2>By post URI (direct from Bluesky)</h2>
  <p>
    Reads a thread straight from the public Bluesky AppView — how paper pages
    will work after the conference, once real post URIs are baked in. Guest
    writes and guest likes are bridged by the service, so this example is
    read-only for a signed-in attendee, shows no reply likes, and lists the
    comments newest first with no sort control; a Bluesky login writes to your
    own account and works here too.
  </p>
  <BlueskyDiscussion
    atUri="at://did:plc:zbr4ntavbfy6nzkupgdgn4sz/app.bsky.feed.post/3msw5eyez7l2k"
    client:load
  />
</PageLayout>
