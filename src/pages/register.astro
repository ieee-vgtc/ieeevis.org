---
// "Pick your day": a short registration path for practitioners, designers and
// Boston locals. The official page (info/registration-and-travel/
// conference-registration) stays the reference for authors. Every Register
// button goes to the Boston Cvent link. Approved by the General Chairs, 10/23.
import DefaultLayout from "../layouts/DefaultLayout.astro";
import { withBaseURL, siteBase } from "../utils/withBaseURL";

const page_info = {
  title: "Pick Your Day",
  description:
    "Register for IEEE VIS 2026 in Boston, November 9–13. Pick one day, two days or the whole week and see your price.",
  active_nav: "Attend",
  contact: "registration@ieeevis.org",
};

const CVENT =
  "https://web.cvent.com/event/bfb61584-aa1d-46ed-9a2e-98101b7b86e4/summary";
const officialPage = withBaseURL(
  "/info/registration-and-travel/conference-registration/",
);
const hotelPage = withBaseURL("/info/registration-and-travel/hotel-information/");
const calendarPage = withBaseURL("/program/calendar/");
---

<DefaultLayout page_info={page_info}>
  <div class="reg" id="reg" data-base={siteBase()}>
    <div class="hotel" id="hotel-band" hidden>
      <div class="wrap">
        <p>
          <strong
            >Staying at the Westin? Book by <span class="hotel-date">Oct 30</span
            ></strong
          > and pay Early Bird rates: up to $70 off a day pass, up to $220 off the
          full week.
        </p>
        <a href="#pass" data-hotel-on>How the hotel deal works</a>
      </div>
    </div>

    <section class="hero" id="week">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <div class="kicker">IEEE VIS 2026 · Boston · November 9–13</div>
            <h1>Pick your day at <em>VIS 2026.</em></h1>
            <p class="lede">
              Five days of visualization in Back Bay, from research papers to
              practitioner talks. Use this page to plan: tap one day, two
              back-to-back days, or the whole week to see what's on and what it
              costs. Then register on the conference's registration site.
            </p>
            <div class="rule" aria-hidden="true"></div>
            <p class="from">
              Day passes from <strong>$419</strong> · IEEE members and students pay
              less
            </p>
            <p class="sat-line">
              Can't get to Boston? <a href="#satellites"
                >Join VIS in Paris or Tianjin</a
              >, November 10–13.
            </p>
          </div>
          <div class="facts" aria-label="The week in numbers">
            <div>280+</div><span>papers in 41 sessions</span>
            <div>13</div><span>workshops</span>
            <div>58</div><span>posters</span>
          </div>
        </div>
        <div class="quick" role="group" aria-label="Shortcuts">
          <button class="chip" type="button" data-preset="0,1,2,3,4"
            >Select the whole week</button
          >
        </div>

        <div class="legend" id="legend"></div>
        <div class="week" id="weekgrid">
          <div class="spine" aria-hidden="true"></div>
          <!-- day cards, unit columns and rings are filled in by the script -->
        </div>
      </div>
    </section>

    <section class="pass" id="pass">
      <div class="wrap">
        <div class="sec-head">
          <div class="kicker">What it costs</div>
          <h2>Your pass</h2>
        </div>
        <ol class="howto" aria-label="How registering works">
          <li>
            <b>Plan here.</b> Pick your days and rate to see your price. Nothing is
            saved or charged on this page.
          </li>
          <li>
            <b>Go to Cvent.</b> Register opens Cvent, the conference's registration
            site. IEEE members sign in with their IEEE account.
          </li>
          <li>
            <b>Register there.</b> Enter your details, choose the pass named below
            under Registration Items, and pay.
          </li>
        </ol>
        <div class="pass-grid">
          <div>
            <fieldset class="qblock">
              <legend class="q">Which rate applies to you?</legend>
              <div class="seg" id="cats"></div>
              <p class="note">
                No IEEE membership needed. Non-members can buy any pass.
              </p>
            </fieldset>
            <div class="qblock" id="stay-block" hidden>
              <label class="stay">
                <input type="checkbox" id="stay" />
                <span
                  ><b>I'm staying at the Westin Copley Place.</b> Book by <span
                    class="hotel-date">Oct 30</span
                  > and your registration drops to the Early Bird rate, even if you've
                  already registered.</span
                >
              </label>
            </div>
          </div>

          <div class="ticket notch" aria-live="polite">
            <div class="kicker">Your pass</div>
            <h3 id="t-name">One-day pass</h3>
            <div class="when" id="t-when">Wednesday, November 11</div>
            <div class="price">
              <span class="now" id="t-price">$419</span><s id="t-was" hidden></s><span
                class="tag"
                id="t-tag"
                hidden>Early Bird with your Westin stay</span
              >
            </div>
            <div class="cat" id="t-cat">Non-member rate, USD</div>
            <div id="t-warn"></div>
            <ul id="t-inc"></ul>
            <ol class="steps" id="t-steps" hidden>
              <li>
                <a href="https://book.passkey.com/e/51276096">Book the Westin</a> at
                the conference rate ($319 a night, before tax).
              </li>
              <li>Register for VIS at any rate.</li>
              <li>
                Fill in the <a href="https://forms.gle/xqmKZRasccN4tZWK8"
                  >Early Bird + hotel form</a
                >. The registration team applies the Early Bird rate.
              </li>
            </ol>
            <div class="go">
              <a class="btn btn-primary cvent" href={CVENT} rel="noopener"
                ><span id="t-go">Register</span> <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5"></path></svg
                ></a
              >
              <span class="note go-note"
                >Pay by card, or by wire transfer for a separate fee (add it under
                Additional Items).</span
              >
            </div>
            <p class="how" id="t-how">
              On Cvent choose <b>One Day – Boston</b> under Registration Items.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="sats" id="satellites">
      <div class="wrap">
        <div class="sec-head">
          <div class="kicker">Satellites · November 10–13</div>
          <h2>Not in Boston? Join VIS in Paris or Tianjin.</h2>
          <p>
            Two satellite sites run their own in-person program each day and
            stream selected Boston sessions, from the opening keynote to the
            capstone. Each has its own registration, and places are limited.
          </p>
        </div>
        <div class="sat-grid">
          <article class="sat notch">
            <div class="kicker">Paris, France</div>
            <h3>Institut des Systèmes Complexes</h3>
            <p class="where">113 rue Nationale, Paris 13e</p>
            <ul>
              <li>
                Mornings: PhD Madness, posters and panels, including Teaching Vis in
                the Age of AI
              </li>
              <li>Afternoons, 2:00–5:30 pm: sessions streamed from Boston</li>
            </ul>
            <p class="sat-cost" data-extra="">
              <b>$599</b> + VAT for all four days (Non-member)
            </p>
            <div class="go">
              <a
                class="btn btn-primary"
                href="https://web.cvent.com/event/0e18a99d-6d50-4799-995e-c6d504f2166f"
                rel="noopener">Register for Paris</a
              >
              <a href={withBaseURL("/satellites/paris/")}>Paris program</a>
            </div>
          </article>
          <article class="sat notch">
            <div class="kicker">Tianjin, China</div>
            <h3>Tianjin University</h3>
            <p class="where">
              Peiyangyuan Campus by day; Novotel Tianjin Meijiang in the evening
            </p>
            <ul>
              <li>
                Days: the China VIS Meetup, local paper presentations and posters
              </li>
              <li>Evenings, 8:00–11:30 pm Beijing time: sessions streamed from Boston</li>
            </ul>
            <p class="sat-cost" data-extra=", also priced in CNY">
              <b>$599</b> + VAT for all four days (Non-member), also priced in CNY
            </p>
            <div class="go">
              <a
                class="btn btn-primary"
                href="https://ieeevis2026.scimeeting.cn/"
                rel="noopener">Register for Tianjin</a
              >
              <a href={withBaseURL("/satellites/tianjin/")}>Tianjin program</a>
            </div>
          </article>
        </div>
        <p class="note sat-note">
          Presenting a full or short paper, or an invited TVCG or CG&amp;A paper, at a
          satellite? One author needs an Author registration. See the <a
            href={officialPage}>official registration page</a
          >.
        </p>
      </div>
    </section>

    <section id="who">
      <div class="wrap">
        <div class="sec-head">
          <div class="kicker">Not sure where to start?</div>
          <h2>Who comes to VIS</h2>
        </div>
        <div class="doors">
          <article class="door notch">
            <h3>I work with data</h3>
            <p>
              Analysts, designers, journalists, engineers, freelancers. Cluster was
              built for you, and it's all on Wednesday.
            </p>
            <button class="door-toggle" type="button" aria-expanded="false" aria-controls="door-data">What to pick</button>
            <div class="door-more" id="door-data" inert>
              <div>
                <p>
                  A one-day Wednesday pass covers Cluster, the VIS Arts Program and
                  the banquet.
                </p>
                <button class="btn btn-small" type="button" data-preset="2" data-go="pass">Select Wednesday</button>
              </div>
            </div>
          </article>
          <article class="door notch">
            <h3>I make art or design with data</h3>
            <p>
              The VIS Arts Program brings papers, pictorials and an exhibition
              opening at the MET Warehouse, all on Wednesday.
            </p>
            <button class="door-toggle" type="button" aria-expanded="false" aria-controls="door-art">What to pick</button>
            <div class="door-more" id="door-art" inert>
              <div>
                <p>
                  A one-day Wednesday pass covers all of VISAP, including the
                  evening keynote and exhibition opening.
                </p>
                <button class="btn btn-small" type="button" data-preset="2" data-go="pass">Select Wednesday</button>
                <a class="door-link" href="#wednesday">See Wednesday's program</a>
              </div>
            </div>
          </article>
          <article class="door notch">
            <h3>I'm in Boston and curious</h3>
            <p>
              Tuesday has the opening keynote from Kimberly Arcand on NASA data, and
              the welcome reception and posters that evening.
            </p>
            <button class="door-toggle" type="button" aria-expanded="false" aria-controls="door-local">What to pick</button>
            <div class="door-more" id="door-local" inert>
              <div>
                <p>
                  A one-day Tuesday pass covers the keynote, the day's sessions and
                  the evening reception.
                </p>
                <button class="btn btn-small" type="button" data-preset="1" data-go="pass">Select Tuesday</button>
              </div>
            </div>
          </article>
          <article class="door notch">
            <h3>I'm a student</h3>
            <p>
              Student rates start at $239 a day for IEEE student members and $289
              for other students.
            </p>
            <button class="door-toggle" type="button" aria-expanded="false" aria-controls="door-student">What to pick</button>
            <div class="door-more" id="door-student" inert>
              <div>
                <p>Pick your student rate, then pick your days above.</p>
                <button class="btn btn-small" type="button" data-rate="ieeeStudent" data-go="pass">IEEE student member</button>
                <button class="btn btn-small" type="button" data-rate="student" data-go="pass">Other student</button>
              </div>
            </div>
          </article>
          <article class="door notch">
            <h3>I'm presenting a paper</h3>
            <p>Paper authors have a few extra registration rules.</p>
            <button class="door-toggle" type="button" aria-expanded="false" aria-controls="door-paper">What to pick</button>
            <div class="door-more" id="door-paper" inert>
              <div>
                <p>
                  Each full or short paper, and each invited TVCG or CG&amp;A paper,
                  needs one author with a Full Conference registration in Boston, or
                  an Author registration at a satellite. Workshop papers and posters
                  don't.
                </p>
                <a class="btn btn-small" href={officialPage}>Read the author rules</a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="wedspot" id="wednesday">
      <div class="wrap">
        <div class="kicker">Wednesday, November 11</div>
        <h2>Wednesday is for practice and art.</h2>
        <div class="rule" aria-hidden="true"></div>
        <div class="twin">
          <article class="prog">
            <div class="kicker">Cluster: The Practitioners' Summit</div>
            <blockquote>
              "If you've ever had to defend a chart to someone who didn't ask for
              one, this is your room."
            </blockquote>
            <ol class="timeline">
              <li>
                <time>8:30 am</time>
                <h3>Welcome and keynote</h3>
                <p>
                  Sophie Sparkes on "Data Viz Isn't a Chart You Drop In at the
                  End."
                </p>
              </li>
              <li>
                <time>8:45 am</time>
                <h3>PolicyViz Podcast, live</h3>
                <p>
                  Jonathan Schwabish with Yannick Assogba, Amber Thomas and Doug
                  Elmendorf, then audience Q&amp;A after the break.
                </p>
              </li>
              <li>
                <time>10:30 am</time>
                <h3>Lightning talks</h3>
                <p>
                  Nine practitioners from Dana-Farber, NASA's Scientific
                  Visualization Studio, Graphicacy, Viz Responsibly and more.
                </p>
              </li>
              <li><time>11:30 am</time><h3>Lunch, included</h3></li>
              <li>
                <time>1:00 pm</time>
                <h3>How to freelance</h3>
                <p>
                  Incorporating, taxes, health insurance and tools, from people
                  who've built their own practices.
                </p>
              </li>
            </ol>
            <a class="more" href="https://cluster-practitioners-summit.github.io/"
              >More about Cluster</a
            >
          </article>
          <article class="prog">
            <div class="kicker">VIS Arts Program · Amplification</div>
            <blockquote>
              "Visualizations as instruments that make the quiet legible and the
              overlooked visible."
            </blockquote>
            <ol class="timeline">
              <li>
                <time>8:00 am</time>
                <h3>Making Data Tangible</h3>
                <p>
                  Data sculptures, participatory performance, tapestries and urban
                  soundscapes, including The Indoor Emerald Necklace on Boston's
                  winter spatial inequality.
                </p>
              </li>
              <li>
                <time>10:00 am</time>
                <h3>Reimagining Archives</h3>
                <p>
                  AI and performance remaking cultural collections, from The
                  Choreographic Genome to The Ocular Harpsichord 2.0.
                </p>
              </li>
              <li>
                <time>1:00 pm</time>
                <h3>Beyond the Visual</h3>
                <p>
                  Pictorials on tactile data, geological memory, language, sound
                  and identity, like Ice Archives on Greenland's ice.
                </p>
              </li>
              <li>
                <time>7:00 pm</time>
                <h3>Keynote and exhibition opening</h3>
                <p>
                  Richard The of TheGreenEyl opens the exhibition at the MET
                  Warehouse at MIT.
                </p>
              </li>
              <li>
                <time>Thu and Fri</time>
                <h3>Exhibition stays open</h3>
                <p>Thursday 9 am – 6 pm and Friday 9 am – noon.</p>
              </li>
            </ol>
            <a class="more" href="https://visap.net/2026/">More about VISAP</a>
          </article>
        </div>
        <div class="together">
          <div class="kicker">And for everyone</div>
          <ol class="timeline">
            <li>
              <time>3:00 pm</time>
              <h3>VISions</h3>
              <p>Zhu-Tian Chen and Ana Crisan on where visualization goes next.</p>
            </li>
            <li>
              <time>6:00 pm</time>
              <h3>Banquet at the MIT Museum</h3>
              <p>
                A ticket comes with any Wednesday pass. Bring a guest by adding a
                banquet ticket when you register.
              </p>
            </li>
          </ol>
          <div>
            <p class="also">
              Also on Wednesday: 64 paper presentations, plus hands-on tutorials on
              anywidget and marimo notebooks and on running online studies with
              reVISit.
            </p>
            <p class="choose">
              <button
                class="btn btn-primary"
                type="button"
                data-preset="2"
                data-go="pass">Choose Wednesday</button
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="team" id="team">
      <div class="wrap team-grid">
        <div class="sec-head">
          <div class="kicker">For companies</div>
          <h2>Bringing a team, or hiring?</h2>
          <p>
            VIS supporter packages include conference registrations for your
            staff, with the reception and banquet, plus a listing on the job
            board. Higher tiers add an exhibition table.
          </p>
          <p>
            <a href={withBaseURL("/assets/IEEE-VIS-2026-Supporters-Prospectus.pdf")}
              >Read the supporter prospectus</a
            > or write to <a href="mailto:supporters@ieeevis.org"
              >supporters@ieeevis.org</a
            >.
          </p>
        </div>
        <div class="tiers" aria-label="Registrations included per supporter tier">
          <div><b>1</b><span>Bronze</span></div>
          <div><b>2</b><span>Silver</span></div>
          <div><b>4</b><span>Gold</span></div>
          <div><b>7</b><span>Platinum</span></div>
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="wrap">
        <div class="sec-head">
          <div class="kicker">Questions</div>
          <h2>Good to know</h2>
        </div>
        <div class="faq">
          <details>
            <summary>I'm not an academic. Is VIS for me?</summary>
            <p>
              Yes. VIS brings together researchers, students and practitioners from
              universities, government and industry. Cluster on Wednesday is for
              anyone doing visualization work outside a pure research role:
              freelancers, in-house teams, journalists, consultants, designers,
              analysts and students.
            </p>
          </details>
          <details>
            <summary>Do I need to be an IEEE member?</summary>
            <p>
              No. Anyone can register at the non-member rate. IEEE members pay a
              lower rate.
            </p>
          </details>
          <details>
            <summary>How does the two-day pass work?</summary>
            <p>
              It covers two back-to-back days, like Tuesday and Wednesday. For three
              or more days, the full conference pass covers the whole week.
            </p>
          </details>
          <details>
            <summary>Can I register at the door?</summary>
            <p>Yes, in Boston. You can also register online now.</p>
          </details>
          <details>
            <summary>Can I bring someone to the banquet?</summary>
            <p>Yes. Extra banquet tickets are available on the registration site.</p>
          </details>
          <details>
            <summary>I can't make it to Boston.</summary>
            <p>
              VIS also runs in person in <a href="#satellites">Paris and Tianjin</a
              >, November 10–13, with separate registration. Every registration
              includes access to the conference's virtual content.
            </p>
          </details>
          <details>
            <summary>Who can I ask?</summary>
            <p>
              Email <a href="mailto:registration@ieeevis.org"
                >registration@ieeevis.org</a
              >.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="closing" id="closing">
      <div class="wrap">
        <h2>See you in Boston, November 9–13.</h2>
        <p>The Westin Copley Place, 10 Huntington Ave, Back Bay.</p>
        <p class="closing-cta">
          <a class="btn btn-primary cvent" href={CVENT} rel="noopener">Register</a>
        </p>
        <div class="links">
          <a href="https://bsky.app/profile/ieeevis.org"
            >Follow @ieeevis.org on Bluesky</a
          >
          <a href={calendarPage}>Full program</a>
          <a href={hotelPage}>Hotel</a>
          <a href="#satellites">Paris and Tianjin</a>
          <a href={officialPage}>Official registration page</a>
        </div>
      </div>
    </section>

    <div class="bar" id="bar" inert>
      <div class="wrap">
        <a class="sum" href="#pass"
          ><strong id="b-price">$419</strong><span id="b-name"
            >Wednesday · one day</span
          ></a
        >
        <a class="btn btn-primary cvent" href={CVENT} rel="noopener">Register</a>
      </div>
    </div>
  </div>
</DefaultLayout>

<script>
  // Hotel + Early Bird package: Josh confirmed Oct 30 (Lane, 10/23). The band
  // and toggle hide after it. Test with ?today=2026-10-31.
  const HOTEL_UNTIL = new Date("2026-10-31T00:00:00-04:00");
  const HOTEL_LABEL = "Oct 30";

  type Cat = "nonmember" | "ieee" | "ieeeStudent" | "student" | "life";
  type Kind = "workshops" | "papers" | "posters" | "visap" | "talks";

  // USD, from the official registration page (checked 2026-10-23). Each row is
  // [full conference, two day, one day]; the Life member rate is full-conference only.
  const RATES: Record<"late" | "early", Record<Cat, (number | null)[]>> = {
    late: {
      nonmember: [1319, 539, 419],
      ieee: [1099, 449, 349],
      ieeeStudent: [599, 299, 239],
      student: [719, 359, 289],
      life: [599, null, null],
    },
    early: {
      nonmember: [1099, 449, 349],
      ieee: [899, 369, 289],
      ieeeStudent: [499, 249, 199],
      student: [599, 299, 239],
      life: [499, null, null],
    },
  };
  // Satellite Attendee (Paris/Tianjin), plus VAT, late rates from the same page.
  // Life members have no attendee rate there, only Satellite Author.
  const SAT_RATES: Record<Cat, number | null> = {
    nonmember: 599,
    ieee: 499,
    ieeeStudent: 359,
    student: 479,
    life: null,
  };
  // Cvent's summary page splits registration into these two buttons. The
  // Register buttons go straight to the one that matches the chosen rate.
  const CVENT_LINK = {
    member:
      "https://web.cvent.com/event/bfb61584-aa1d-46ed-9a2e-98101b7b86e4/register?rp=ea779f6f-d344-4a59-b9a9-a11cb201dc1f",
    nonmember:
      "https://web.cvent.com/event/bfb61584-aa1d-46ed-9a2e-98101b7b86e4/register?rp=0efb9c00-cd36-40f2-bc5d-2e5cc0ac209c",
  };
  const isMember = (c: Cat) => c === "ieee" || c === "ieeeStudent" || c === "life";
  const CATS: [Cat, string][] = [
    ["nonmember", "Non-member"],
    ["ieee", "IEEE member"],
    ["ieeeStudent", "IEEE student member"],
    ["student", "Student, not an IEEE member"],
    ["life", "IEEE Life member"],
  ];

  // Presentations per day and kind, recounted from the program on 2026-10-23.
  // Papers = full, short, TVCG and CG&A (283 in 41 sessions); VISAP papers and
  // pictorials are their own type.
  // TODO: derive STATS and the day counts from the program data
  // (src/utils/paperData.ts) at build time. That data needs the site build key
  // (npm run getData), so these stay hard-coded for now.
  const KINDS: [Kind, string, string][] = [
    ["workshops", "Workshop and challenge talks", "var(--raspberry)"],
    ["papers", "Papers", "var(--orange-700)"],
    ["posters", "Posters", "var(--brown)"],
    ["visap", "VIS Arts Program", "var(--raspberry-200)"],
    ["talks", "Keynotes and invited talks", "var(--orange-200)"],
  ];
  const UNIT_COLORS = Object.fromEntries(KINDS.map(([k, , c]) => [k, c]));
  const STATS: Record<string, Partial<Record<Kind, number>>> = {
    mon: { workshops: 117 },
    tue: { workshops: 13, papers: 80, posters: 58, talks: 2 },
    wed: { papers: 64, visap: 15, talks: 3 },
    thu: { papers: 110 },
    fri: { papers: 29, talks: 1 },
  };

  type Day = {
    id: string;
    dow: string;
    date: string;
    long: string;
    title: string;
    wed?: boolean;
    counts: [Kind, number, string][];
    who?: [string, string, string];
    items: [string, string][];
  };

  // Times from the ieeevis.org program (sessions list, 2026-10-23). `counts`
  // rows use the same kinds and colors as the squares above each card.
  const DAYS: Day[] = [
    {
      id: "mon",
      dow: "MON",
      date: "Nov 9",
      long: "Monday, November 9",
      title: "Workshops",
      counts: [["workshops", 117, "talks in 13 workshops, 3 challenges"]],
      items: [
        ["8:00 am – 4:30 pm", "VISxAI, VISxGenAI, vis4climate, AccessViz, EduVis and more"],
        ["Workshop keynotes", "Including Zoya Bylinskii and Leland McInnes"],
      ],
    },
    {
      id: "tue",
      dow: "TUE",
      date: "Nov 10",
      long: "Tuesday, November 10",
      title: "Opening keynote",
      counts: [
        ["workshops", 13, "workshop talks"],
        ["papers", 80, "papers, 12 sessions"],
        ["posters", 58, "posters"],
        ["talks", 2, "keynote and invited talks"],
      ],
      who: [
        "kimberly-arcand.jpg",
        "Kimberly Arcand",
        "Beyond the Image: Turning NASA Data Into Human Experience",
      ],
      items: [
        ["8:00 am", "Opening and keynote"],
        ["All day", "Paper sessions, panels, tutorials and meetups"],
        ["6:30 pm", "Welcome reception and posters"],
      ],
    },
    {
      id: "wed",
      dow: "WED",
      date: "Nov 11",
      long: "Wednesday, November 11",
      title: "Cluster + VISAP",
      wed: true,
      counts: [
        ["papers", 64, "papers, 9 sessions"],
        ["visap", 15, "arts papers and pictorials"],
        ["talks", 3, "keynote and invited talks"],
      ],
      items: [
        ["8:00 am", "VIS Arts Program: 15 papers and pictorials"],
        ["8:30 am", "Cluster: The Practitioners’ Summit, with nine lightning talks"],
        ["3:00 pm", "VISions"],
        ["6:00 pm", "Banquet at the MIT Museum"],
        ["7:00 pm", "VISAP keynote and exhibition opening"],
      ],
    },
    {
      id: "thu",
      dow: "THU",
      date: "Nov 12",
      long: "Thursday, November 12",
      title: "Papers",
      counts: [["papers", 110, "papers, 16 sessions"]],
      items: [
        ["All day", "The busiest day of paper sessions, plus panels and tutorials"],
        ["9:00 am – 6:00 pm", "VISAP exhibition at the MET Warehouse"],
        ["11:30 am", "Town Hall"],
        ["1:00 pm", "Tutorial: Visualization Analysis and Design, organized by Tamara Munzner"],
      ],
    },
    {
      id: "fri",
      dow: "FRI",
      date: "Nov 13",
      long: "Friday, November 13",
      title: "Capstone",
      counts: [
        ["papers", 29, "papers, 4 sessions"],
        ["talks", 1, "capstone talk"],
      ],
      who: ["Nils.png", "Nils Gehlenborg", "The Eyes Still Have It: Do They?"],
      items: [
        ["8:00 am", "Final paper sessions"],
        ["9:00 am – noon", "VISAP exhibition at the MET Warehouse"],
        ["10:00 am", "Capstone and closing, done by 11:30"],
      ],
    },
  ];

  type Pass =
    | { kind: "none" }
    | { kind: "gap"; d: number[] }
    | {
        kind: "one" | "two" | "full";
        idx: number;
        name: string;
        when: string;
        short: string;
        cvent: string;
        d: number[];
      };

  const root = document.getElementById("reg")!;
  const $ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = root) =>
    r.querySelector(s) as T;
  const $$ = <T extends HTMLElement = HTMLElement>(s: string, r: ParentNode = root) => [
    ...r.querySelectorAll<T>(s),
  ];
  const usd = (n: number) => "$" + n.toLocaleString("en-US");
  const cap = (s: string) => s[0] + s.slice(1).toLowerCase();
  const CHECK =
    '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M4 10.5l4 4 8-9"/></svg>';
  const IMG_BASE = `${root.dataset.base}/assets/keynote-speakers/`;

  const params = new URLSearchParams(location.search);
  const today = params.get("today")
    ? new Date(params.get("today") + "T12:00:00-04:00")
    : new Date();
  const hotelOpen = today < HOTEL_UNTIL;

  const state: { days: Set<number>; cat: Cat; stay: boolean } = {
    days: new Set(),
    cat: "nonmember",
    stay: false,
  };

  // Week grid: unit columns (row 1), rings on the spine (row 2), day cards (row 3).
  const grid = $("#weekgrid");
  DAYS.forEach((d, i) => {
    const units = document.createElement("div");
    units.className = "units";
    units.style.gridColumn = String(i + 1);
    units.setAttribute("aria-hidden", "true");
    const total = Object.values(STATS[d.id]).reduce((a, b) => a + (b ?? 0), 0);
    units.title = `${d.dow}: ${total} scheduled presentations`;
    for (const [k, , c] of KINDS) {
      for (let n = 0; n < (STATS[d.id][k] ?? 0); n++)
        units.insertAdjacentHTML("beforeend", `<i class="c-${k}" style="background:${c}"></i>`);
    }
    units.addEventListener("click", () => toggle(i));
    grid.append(units);

    const ring = document.createElement("div");
    ring.className = "day-ring";
    ring.style.gridColumn = String(i + 1);
    ring.setAttribute("aria-hidden", "true");
    grid.append(ring);

    const card = document.createElement("button");
    card.type = "button";
    card.className = "day notch" + (d.wed ? " wed" : "");
    card.style.gridColumn = String(i + 1);
    card.dataset.i = String(i);
    card.setAttribute("aria-label", `${d.long}: ${d.title}`);
    const desc = document.createElement("span");
    desc.id = `day-desc-${i}`;
    desc.hidden = true;
    desc.textContent = [
      ...d.counts.map(([, n, l]) => `${n} ${l}`),
      d.wed ? "Cluster, VISAP and the banquet come with a Wednesday pass" : "",
      d.who ? `${d.who[1]}: ${d.who[2]}` : "",
      ...d.items.map(([t, x]) => `${t}: ${x}`),
    ]
      .filter(Boolean)
      .join(". ");
    grid.append(desc);
    card.setAttribute("aria-describedby", desc.id);
    card.innerHTML = `
      <span class="dow"><span>${d.dow}</span><span>${d.date}</span></span>
      <h3>${d.title}</h3>
      <ul class="counts">${d.counts.map(([k, n, l]) => `<li data-cat="${k}"><i class="sw" style="background:${UNIT_COLORS[k]}"></i><span><b>${n}</b> ${l}</span></li>`).join("")}</ul>
      ${d.wed ? '<span class="inc"><strong>Cluster, VISAP + banquet</strong>All three come with a Wednesday pass</span>' : ""}
      ${d.who ? `<span class="who"><img src="${IMG_BASE}${d.who[0]}" alt="" width="44" height="44" loading="lazy" decoding="async"><span><b>${d.who[1]}</b><br>${d.who[2]}</span></span>` : ""}
      <ul>${d.items.map(([t, x]) => `<li><b>${t}</b>${x}</li>`).join("")}</ul>
      <span class="pick"><span class="box">${CHECK}</span><span class="pick-label">Add this day</span></span>`;
    card.addEventListener("click", () => toggle(i));
    grid.append(card);
  });

  // Legend keys, and hover linking between counts, keys and squares.
  $("#legend").insertAdjacentHTML(
    "beforeend",
    KINDS.map(
      ([k, label, c]) =>
        `<span class="key" data-cat="${k}"><i class="sw" style="background:${c}"></i>${label}</span>`,
    ).join(""),
  );
  const focusKind = (k: string | null) => {
    if (k) grid.dataset.focus = k;
    else delete grid.dataset.focus;
    $$("[data-cat]").forEach((el) => el.classList.toggle("on", !!k && el.dataset.cat === k));
  };
  $$(".key[data-cat], .counts li[data-cat]").forEach((el) => {
    el.addEventListener("mouseenter", () => focusKind(el.dataset.cat ?? null));
    el.addEventListener("mouseleave", () => focusKind(null));
  });

  // Rate chooser.
  $("#cats").innerHTML = CATS.map(
    ([k, label]) =>
      `<label><input type="radio" name="cat" value="${k}" ${k === state.cat ? "checked" : ""}><span>${label}</span></label>`,
  ).join("");
  $$<HTMLInputElement>("#cats input").forEach((r) =>
    r.addEventListener("change", () => {
      state.cat = r.value as Cat;
      render();
    }),
  );

  if (hotelOpen) {
    $("#hotel-band").hidden = false;
    $("#stay-block").hidden = false;
    $$(".hotel-date").forEach((s) => (s.textContent = HOTEL_LABEL));
  }
  const stay = $<HTMLInputElement>("#stay");
  stay.addEventListener("change", () => {
    state.stay = stay.checked;
    render();
  });
  $$("[data-hotel-on]").forEach((a) =>
    a.addEventListener("click", () => {
      state.stay = true;
      stay.checked = true;
      render();
    }),
  );

  function toggle(i: number) {
    if (state.days.has(i)) state.days.delete(i);
    else state.days.add(i);
    render();
  }
  function setDays(list: number[]) {
    state.days = new Set(list);
    render();
  }

  $$<HTMLButtonElement>(".door-toggle").forEach((t) =>
    t.addEventListener("click", () => {
      const open = t.getAttribute("aria-expanded") !== "true";
      t.setAttribute("aria-expanded", String(open));
      t.closest(".door")!.classList.toggle("open", open);
      document.getElementById(t.getAttribute("aria-controls")!)!.inert = !open;
    }),
  );

  $$("[data-preset]").forEach((b) =>
    b.addEventListener("click", () => {
      setDays(b.dataset.preset!.split(",").map(Number));
      if (b.dataset.go) document.getElementById(b.dataset.go)!.scrollIntoView();
    }),
  );
  $$("[data-rate]").forEach((b) =>
    b.addEventListener("click", () => {
      state.cat = b.dataset.rate as Cat;
      $<HTMLInputElement>(`#cats input[value="${state.cat}"]`).checked = true;
      render();
      document.getElementById(b.dataset.go!)!.scrollIntoView();
    }),
  );

  // One day, two back-to-back days, or the full week (3+ days).
  function passFor(days: Set<number>): Pass {
    const d = [...days].sort((a, b) => a - b);
    if (d.length === 0) return { kind: "none" };
    if (d.length === 1)
      return {
        kind: "one",
        idx: 2,
        name: "One-day pass",
        when: DAYS[d[0]].long,
        short: `${cap(DAYS[d[0]].dow)} · one day`,
        cvent: "One Day – Boston",
        d,
      };
    if (d.length === 2 && d[1] - d[0] === 1)
      return {
        kind: "two",
        idx: 1,
        name: "Two-day pass",
        when: `${DAYS[d[0]].long.split(",")[0]} and ${DAYS[d[1]].long.split(",")[0]}, November ${9 + d[0]}–${10 + d[0]}`,
        short: `${cap(DAYS[d[0]].dow)} + ${cap(DAYS[d[1]].dow)} · two days`,
        cvent: "Two Day – Boston",
        d,
      };
    if (d.length === 2) return { kind: "gap", d };
    return {
      kind: "full",
      idx: 0,
      name: "Full conference",
      when: "Monday, November 9 to Friday, November 13",
      short: "Full week",
      cvent: "Full Conference – Boston",
      d: [0, 1, 2, 3, 4],
    };
  }

  function render() {
    const pass = passFor(state.days);
    const covered = new Set("d" in pass ? pass.d : [...state.days]);

    $$(".day").forEach((c) => {
      const i = Number(c.dataset.i);
      const on = state.days.has(i) || (pass.kind === "full" && covered.has(i));
      c.setAttribute("aria-pressed", String(on));
      $(".pick-label", c).textContent = on ? "Added" : "Add this day";
    });
    $$(".day-ring").forEach((r, i) => r.classList.toggle("on", covered.has(i)));
    const picked = [...state.days].sort((a, b) => a - b).join(",");
    $$(".quick .chip").forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.preset === picked)),
    );

    // Life-member rate is full-conference only.
    const lifeInput = $<HTMLInputElement>('#cats input[value="life"]');
    lifeInput.disabled = pass.kind === "one" || pass.kind === "two";
    if (lifeInput.disabled && state.cat === "life") {
      state.cat = "ieee";
      $<HTMLInputElement>('#cats input[value="ieee"]').checked = true;
    }

    const useEarly = hotelOpen && state.stay;
    const warn = $("#t-warn");
    warn.innerHTML = "";
    if (pass.kind === "none") {
      // Nothing picked yet: show this rate's three prices instead of a blank.
      const r = RATES[useEarly ? "early" : "late"][state.cat];
      $("#t-name").textContent = "Pick your days above";
      $("#t-when").textContent = [
        r[2] && `One day ${usd(r[2])}`,
        r[1] && `two days ${usd(r[1])}`,
        `the full week ${usd(r[0]!)}`,
      ]
        .filter(Boolean)
        .join(" · ");
    } else if (pass.kind === "gap") {
      $("#t-name").textContent = "Two-day passes are back to back";
      $("#t-when").textContent =
        `${DAYS[pass.d[0]].long.split(",")[0]} and ${DAYS[pass.d[1]].long.split(",")[0]} aren't next to each other.`;
      warn.innerHTML = `<div class="warn">Pick two days in a row, or go for the full week.<br><button class="chip" type="button" id="to-full">Switch to the full week</button></div>`;
      $("#to-full").addEventListener("click", () => setDays([0, 1, 2, 3, 4]));
    } else {
      $("#t-name").textContent = pass.name;
      $("#t-when").textContent = pass.when;
      if (pass.kind === "full" && state.days.size < 5) {
        warn.innerHTML =
          '<div class="warn">Three or more days? The full conference pass covers the whole week.</div>';
      }
    }

    const priced = pass.kind === "one" || pass.kind === "two" || pass.kind === "full";
    const late = priced ? RATES.late[state.cat][pass.idx]! : 0;
    const early = priced ? RATES.early[state.cat][pass.idx]! : 0;
    $("#t-price").textContent = priced ? usd(useEarly ? early : late) : "";
    $(".ticket .price").hidden = !priced;
    $("#t-was").hidden = !(priced && useEarly);
    $("#t-was").textContent = priced ? usd(late) : "";
    $("#t-tag").hidden = !(priced && useEarly);
    $("#t-steps").hidden = !useEarly;
    $("#t-cat").textContent = `${CATS.find(([k]) => k === state.cat)![1]} rate, USD`;
    const member = isMember(state.cat);
    $$<HTMLAnchorElement>("a.cvent").forEach(
      (a) => (a.href = CVENT_LINK[member ? "member" : "nonmember"]),
    );
    $("#t-go").textContent = priced ? `Register: ${pass.cvent}` : "Register";
    $("#t-how").innerHTML = !priced
      ? ""
      : member
        ? `On Cvent sign in with your IEEE account and choose <b>${pass.cvent}</b> under Registration Items.`
        : `On Cvent choose <b>${pass.cvent}</b> under Registration Items.`;

    const sat = SAT_RATES[state.cat];
    const catLabel = CATS.find(([k]) => k === state.cat)![1];
    $$(".sat-cost").forEach((p) => {
      p.innerHTML = sat
        ? `<b>${usd(sat)}</b> + VAT for all four days (${catLabel})${p.dataset.extra}`
        : "IEEE Life members: Satellite Author registration only, <b>$599</b> + VAT";
    });

    const inc: string[] = [];
    if (priced) {
      inc.push(
        pass.kind === "full"
          ? "Every session and event, Monday to Friday"
          : "Every session and event on your day" + (pass.kind === "two" ? "s" : ""),
      );
      if (covered.has(1)) inc.push("Welcome reception and posters, Tuesday evening");
      if (covered.has(2)) inc.push("Cluster: The Practitioners’ Summit, with lunch");
      if (covered.has(2))
        inc.push("The VIS Arts Program, including the keynote and exhibition opening");
      if (covered.has(2)) inc.push("A ticket to the banquet at the MIT Museum");
      inc.push("Access to the conference’s virtual content");
    }
    $("#t-inc").innerHTML = inc.map((x) => `<li>${CHECK}<span>${x}</span></li>`).join("");

    $("#b-price").textContent = priced ? usd(useEarly ? early : late) : "Pick a day";
    $("#b-name").textContent = priced ? pass.short : "Choose from the week";
  }
  render();

  // Sticky bar: shows once you're past the hero, and hides while the pass card
  // or the satellite cards are on screen (so Boston's button never sits over
  // Paris and Tianjin) and from the closing Register button down, so it never
  // covers the site footer.
  const bar = $("#bar");
  let pastHero = false;
  let passVisible = false;
  let satsVisible = false;
  let atEnd = false;
  const sync = () => {
    const on = pastHero && !passVisible && !satsVisible && !atEnd;
    bar.classList.toggle("show", on);
    // inert keeps the off-screen bar's links out of the tab order and away
    // from screen readers.
    bar.inert = !on;
  };
  new IntersectionObserver(([e]) => {
    pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
    sync();
  }).observe($(".hero"));
  new IntersectionObserver(
    ([e]) => {
      passVisible = e.isIntersecting;
      sync();
    },
    { threshold: 0.25 },
  ).observe($(".ticket"));
  new IntersectionObserver(([e]) => {
    satsVisible = e.isIntersecting;
    sync();
  }).observe($(".sat-grid"));
  new IntersectionObserver(([e]) => {
    atEnd = e.isIntersecting || e.boundingClientRect.top < 0;
    sync();
  }).observe($(".closing"));
</script>

<style is:global>
  /* Brand tokens, mapped onto the site theme (src/styles/theme.css). Peach-50
     and ink aren't in the theme. Everything is scoped under .reg. */
  .reg {
    --orange: var(--color-primary, #df6824);
    --orange-800: var(--color-primary-800, #934e13);
    --orange-700: var(--color-primary-700, #c4681a);
    --orange-500: var(--color-primary-500, #f79b4d);
    --orange-200: var(--color-primary-200, #f9b479);
    --raspberry: var(--color-secondary, #bb4a72);
    --raspberry-200: var(--color-secondary-200, #ed74b5);
    --brown: var(--color-accent, #693a19);
    --peach: var(--color-accent-secondaryBackground, #f3dfcf);
    --peach-50: #fbf3ec;
    --ink: #3b352f;
    --gray-700: var(--color-gray-700, #616161);
    --white: #fff;
    --notch: 18px;
    --display: var(--font-display, "Zilla Slab", Georgia, serif);
    --body: var(--font-body, "Fira Sans", system-ui, sans-serif);
    --max: 1140px;
    background: var(--peach-50);
    color: var(--ink);
    font: 400 17px/1.55 var(--body);
  }
  /* The site's main gets top padding on phones under the fixed nav; let the hero meet the nav. */
  @media (max-width: 767px) {
    .reg {
      margin-top: -1.5rem;
    }
    .reg section {
      scroll-margin-top: 70px;
    }
  }
  .reg a {
    color: var(--orange-800);
    text-decoration: underline;
  }
  .reg p {
    margin: 1em 0;
  }
  .reg h1,
  .reg h2,
  .reg h3 {
    font-family: var(--display);
    font-weight: 700;
    line-height: 1.08;
    margin: 0;
    color: inherit;
  }
  .reg .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 16px;
  }
  @media (min-width: 760px) {
    .reg .wrap {
      padding: 0 32px;
    }
  }
  .reg .kicker {
    font: 700 13px/1.2 var(--body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--raspberry);
  }
  .reg .notch {
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--notch)),
      calc(100% - var(--notch)) 100%,
      0 100%
    );
  }

  /* Signature rule: dashed line ending in an open ring. */
  .reg .rule {
    display: flex;
    align-items: center;
    color: var(--raspberry);
  }
  .reg .rule::before {
    content: "";
    flex: 1;
    border-top: 2px dashed currentColor;
  }
  .reg .rule::after {
    content: "";
    width: 12px;
    height: 12px;
    border: 2px solid currentColor;
    border-radius: 50%;
    flex: none;
  }

  .reg .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    font: 700 19px/1 var(--body);
    text-decoration: none;
    border: 0;
    cursor: pointer;
  }
  .reg .btn-primary {
    background: var(--orange-700);
    color: var(--white);
  }
  .reg .btn-primary:hover {
    background: var(--orange-800);
  }
  .reg .btn svg {
    width: 18px;
    height: 18px;
  }
  .reg :focus-visible {
    outline: 3px solid var(--raspberry);
    outline-offset: 3px;
  }

  /* Hero */
  .reg .hero {
    background: var(--peach);
    padding: 36px 0 56px;
  }
  .reg .hero h1 {
    font-size: clamp(38px, 5.4vw, 64px);
    color: var(--brown);
    margin-top: 12px;
  }
  .reg .hero h1 em {
    font-style: normal;
    color: var(--raspberry);
  }
  .reg .hero p.lede {
    font-size: clamp(17px, 1.9vw, 20px);
    max-width: 52ch;
    color: var(--brown);
    margin: 14px 0 0;
  }
  .reg .hero .rule {
    max-width: 420px;
    margin: 18px 0 14px;
  }
  .reg .hero .from {
    margin: 0;
    font-size: 15px;
    color: var(--brown);
  }
  .reg .hero .from strong {
    font: 700 22px var(--display);
    color: var(--orange-800);
  }
  .reg .hero-grid {
    display: grid;
    gap: 32px;
  }
  .reg .facts {
    align-self: end;
    display: grid;
    grid-template-rows: auto auto;
    grid-auto-flow: column;
    gap: 4px 24px;
    justify-content: start;
  }
  .reg .facts div {
    font: 700 clamp(30px, 3.6vw, 40px) / 1 var(--display);
    color: var(--orange-800);
  }
  .reg .facts span {
    font-size: 14px;
    font-weight: 500;
    color: var(--brown);
  }
  @media (min-width: 900px) {
    .reg .hero-grid {
      grid-template-columns: 1fr auto;
    }
    .reg .facts {
      gap: 4px 32px;
    }
  }

  /* Hotel deal band */
  .reg .hotel {
    background: var(--raspberry);
    color: var(--white);
  }
  .reg .hotel .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 18px;
  }
  .reg .hotel p {
    margin: 0;
    font-size: 18px;
    max-width: 62ch;
  }
  .reg .hotel strong {
    font-family: var(--display);
    font-size: 22px;
  }
  .reg .hotel a {
    color: var(--white);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Week chooser */
  .reg section {
    padding: 56px 0;
  }
  .reg .sec-head h2 {
    font-size: clamp(32px, 5vw, 48px);
    color: var(--brown);
    margin-top: 8px;
  }
  .reg .sec-head p {
    margin: 10px 0 0;
    max-width: 60ch;
    color: var(--brown);
  }
  .reg .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0 0;
  }
  .reg .chip {
    font: 500 15px var(--body);
    padding: 8px 14px;
    border: 2px solid var(--brown);
    background: transparent;
    color: var(--brown);
    cursor: pointer;
    border-radius: 999px;
  }
  .reg .chip:hover,
  .reg .chip[aria-pressed="true"] {
    background: var(--brown);
    color: var(--white);
  }

  .reg .week {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 28px;
    position: relative;
  }
  .reg .units,
  .reg .spine,
  .reg .day-ring {
    display: none;
  }
  @media (min-width: 900px) {
    .reg .week {
      grid-template-columns: 1fr 1fr 1.45fr 1fr 1fr;
      grid-template-rows: auto 28px auto;
      gap: 0 12px;
    }
    .reg .units {
      display: flex;
      flex-wrap: wrap;
      align-content: flex-end;
      gap: 2px;
      height: 128px;
      padding: 0 6px 8px;
      cursor: pointer;
      grid-row: 1;
    }
    .reg .units i {
      width: 8px;
      height: 8px;
      border-radius: 1px;
    }
    .reg .spine {
      display: block;
      grid-row: 2;
      grid-column: 1 / -1;
      align-self: center;
      border-top: 2px dashed var(--raspberry);
    }
    .reg .day-ring {
      display: block;
      grid-row: 2;
      justify-self: center;
      align-self: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 3px solid var(--raspberry);
      background: var(--peach);
      opacity: 0;
      transition:
        opacity 0.2s,
        transform 0.2s;
      transform: scale(0.6);
    }
    .reg .day-ring.on {
      opacity: 1;
      transform: scale(1);
    }
    .reg .day {
      grid-row: 3;
    }
  }
  .reg .day {
    position: relative;
    text-align: left;
    font: inherit;
    color: inherit;
    background: var(--white);
    border: 0;
    padding: 18px 18px 26px 26px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.15s;
  }
  .reg .day::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--orange-500);
  }
  .reg .day:hover {
    transform: translateY(-2px);
  }
  .reg .day:focus-visible {
    outline: 3px solid var(--brown);
    outline-offset: -10px;
  }
  .reg .day.wed:focus-visible {
    outline-color: var(--white);
  }
  .reg .day[aria-pressed="true"] {
    box-shadow: inset 0 0 0 4px var(--raspberry);
  }
  .reg .day .dow {
    font: 700 14px var(--body);
    letter-spacing: 0.14em;
    color: var(--raspberry);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }
  .reg .day .dow span:last-child {
    font-weight: 500;
    letter-spacing: 0;
    color: var(--gray-700);
  }
  .reg .day h3 {
    font-size: 26px;
    color: var(--orange-800);
  }
  .reg .day ul {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    font-size: 15px;
    line-height: 1.4;
    display: grid;
    gap: 8px;
  }
  .reg .day li b {
    font-weight: 500;
    display: block;
    color: var(--gray-700);
    font-size: 13px;
  }
  .reg .day .who {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.3;
  }
  .reg .day .who img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .reg .day .pick {
    margin-top: auto;
    padding-top: 10px;
    font: 700 15px var(--body);
    color: var(--orange-800);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .reg .day .pick .box {
    width: 20px;
    height: 20px;
    border: 2px solid currentColor;
    border-radius: 3px;
    display: grid;
    place-items: center;
  }
  .reg .day .pick svg {
    width: 14px;
    height: 14px;
    visibility: hidden;
  }
  .reg .day[aria-pressed="true"] .pick svg {
    visibility: visible;
  }
  .reg .day.wed {
    background: var(--raspberry);
    color: var(--white);
  }
  .reg .day.wed::before {
    border-color: rgba(255, 255, 255, 0.55);
  }
  .reg .day.wed .dow,
  .reg .day.wed .dow span:last-child,
  .reg .day.wed li b {
    color: var(--peach);
  }
  .reg .day.wed h3,
  .reg .day.wed .pick {
    color: var(--white);
  }
  .reg .day.wed[aria-pressed="true"] {
    box-shadow: inset 0 0 0 4px var(--brown);
  }
  .reg .day.wed .inc {
    background: rgba(255, 255, 255, 0.14);
    padding: 10px 12px;
    font-size: 14px;
    line-height: 1.35;
  }
  .reg .day.wed .inc strong {
    display: block;
    font-family: var(--display);
    font-size: 19px;
  }
  /* Phone: vertical spine on the left of the stacked days. */
  @media (max-width: 899px) {
    .reg .week {
      padding-left: 30px;
    }
    .reg .week .day {
      grid-column: auto !important;
    }
    /* clip-path would hide the ring, so draw the notch with a gradient here. */
    .reg .day.notch {
      clip-path: none;
      background: linear-gradient(-45deg, transparent 13px, var(--white) 0);
    }
    .reg .day.wed.notch {
      background: linear-gradient(-45deg, transparent 13px, var(--raspberry) 0);
    }
    .reg .week::before {
      content: "";
      position: absolute;
      left: 9px;
      top: 6px;
      bottom: 6px;
      border-left: 2px dashed var(--raspberry);
    }
    .reg .day::after {
      content: "";
      position: absolute;
      left: -30px;
      top: 22px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      border: 3px solid var(--raspberry);
      background: var(--peach);
      opacity: 0;
      transition: opacity 0.2s;
    }
    .reg .day[aria-pressed="true"]::after {
      opacity: 1;
    }
  }
  .reg .legend {
    display: none;
    margin-top: 26px;
    font-size: 14px;
    color: var(--brown);
    gap: 6px 16px;
    flex-wrap: wrap;
    align-items: center;
  }
  .reg .legend .key {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    cursor: default;
    padding: 2px 4px;
    border-radius: 3px;
  }
  .reg .sw {
    width: 10px;
    height: 10px;
    border-radius: 1px;
    display: inline-block;
    flex: none;
  }
  @media (min-width: 900px) {
    .reg .legend {
      display: flex;
    }
  }
  /* Hovering a count or a key picks out that kind of presentation across the week. */
  .reg .units i {
    transition: opacity 0.15s;
  }
  .reg .week[data-focus] .units i {
    opacity: 0.15;
  }
  .reg .week[data-focus="workshops"] .units i.c-workshops,
  .reg .week[data-focus="papers"] .units i.c-papers,
  .reg .week[data-focus="posters"] .units i.c-posters,
  .reg .week[data-focus="visap"] .units i.c-visap,
  .reg .week[data-focus="talks"] .units i.c-talks {
    opacity: 1;
  }
  .reg .legend .key.on,
  .reg .day .counts li.on {
    background: rgba(105, 58, 25, 0.1);
  }
  .reg .day.wed .counts li.on {
    background: rgba(255, 255, 255, 0.18);
  }
  .reg .day .counts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font: 500 14px/1.3 var(--body);
    color: var(--brown);
  }
  .reg .day .counts li {
    display: flex;
    gap: 7px;
    align-items: baseline;
    padding: 1px 4px;
    margin: 0 -4px;
    border-radius: 3px;
  }
  .reg .day .counts .sw {
    transform: translateY(-1px);
  }
  .reg .day .counts b {
    display: inline;
    font: 700 20px/1 var(--display);
    color: var(--orange-800);
  }
  .reg .day.wed .counts,
  .reg .day.wed .counts b {
    color: var(--white);
  }
  .reg .day.wed .counts .sw {
    box-shadow: 0 0 0 1.5px var(--white);
  }
  @media (max-width: 899px) {
    .reg .day .counts .sw {
      display: none;
    }
  }

  /* Your pass */
  .reg .pass-grid {
    display: grid;
    gap: 28px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .reg .pass-grid {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
  }
  .reg fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .reg legend.q {
    font: 700 20px var(--display);
    color: var(--brown);
    margin-bottom: 10px;
    padding: 0;
  }
  .reg .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .reg .seg label {
    position: relative;
  }
  .reg .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }
  .reg .seg span {
    display: block;
    padding: 10px 14px;
    background: var(--white);
    border: 2px solid transparent;
    font-weight: 500;
    font-size: 15px;
    cursor: pointer;
    color: var(--brown);
  }
  .reg .seg input:checked + span {
    border-color: var(--raspberry);
    color: var(--raspberry);
    font-weight: 700;
  }
  .reg .seg input:focus-visible + span {
    outline: 3px solid var(--raspberry);
    outline-offset: 2px;
  }
  .reg .seg input:disabled + span {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .reg .qblock + .qblock {
    margin-top: 26px;
  }
  .reg .note {
    font-size: 14px;
    color: var(--brown);
    margin: 8px 0 0;
  }
  .reg .stay {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    background: var(--white);
    padding: 14px 16px;
    cursor: pointer;
  }
  .reg .stay input {
    width: 20px;
    height: 20px;
    margin: 3px 0 0;
    accent-color: var(--raspberry);
    flex: none;
  }
  .reg .stay b {
    color: var(--raspberry);
  }

  .reg .ticket {
    background: var(--white);
    padding: 26px 26px 34px;
    position: relative;
  }
  .reg .ticket::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--orange-500);
  }
  .reg .ticket h3 {
    font-size: 28px;
    color: var(--orange-800);
    margin-top: 6px;
  }
  .reg .ticket .when {
    color: var(--gray-700);
    margin-top: 4px;
    font-size: 15px;
  }
  .reg .price {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 18px 0 4px;
    flex-wrap: wrap;
  }
  .reg .price .now {
    font: 700 64px/1 var(--display);
    color: var(--brown);
  }
  .reg .price s {
    font: 500 26px var(--display);
    color: var(--gray-700);
  }
  .reg .price .tag {
    font-size: 14px;
    font-weight: 700;
    color: var(--raspberry);
  }
  .reg .ticket .cat {
    font-size: 14px;
    color: var(--gray-700);
  }
  .reg .ticket ul {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .reg .ticket li {
    display: flex;
    gap: 10px;
  }
  .reg .ticket li svg {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 4px;
    color: var(--raspberry);
  }
  .reg .ticket .go {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
  }
  .reg .ticket .go-note {
    margin: 0;
  }
  .reg .ticket .how {
    font-size: 14px;
    color: var(--gray-700);
    margin: 14px 0 0;
  }
  .reg .warn {
    background: var(--peach-50);
    border-left: 4px solid var(--raspberry);
    padding: 12px 14px;
    margin-top: 16px;
    font-size: 15px;
  }
  .reg .warn button {
    margin-top: 8px;
  }
  .reg .steps {
    margin: 16px 0 0;
    padding: 14px 16px 14px 34px;
    background: var(--peach-50);
    font-size: 15px;
    list-style: decimal;
  }
  .reg .steps li {
    display: list-item;
  }
  .reg .steps li + li {
    margin-top: 6px;
  }

  /* How registering works */
  .reg .howto {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    counter-reset: howto;
  }
  @media (min-width: 900px) {
    .reg .howto {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }
  .reg .howto li {
    counter-increment: howto;
    position: relative;
    padding: 0 0 0 44px;
    font-size: 15px;
    line-height: 1.45;
    color: var(--brown);
  }
  .reg .howto li::before {
    content: counter(howto);
    position: absolute;
    left: 0;
    top: -2px;
    width: 30px;
    height: 30px;
    border: 2px solid var(--raspberry);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font: 700 16px var(--display);
    color: var(--raspberry);
  }
  .reg .howto b {
    display: block;
    font: 700 18px var(--display);
  }
  .reg .ticket .how b {
    color: var(--brown);
  }

  /* Satellites */
  .reg .hero .sat-line {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--brown);
  }
  .reg .hero .sat-line a {
    color: var(--raspberry);
    font-weight: 700;
  }
  .reg .sats {
    background: var(--peach);
  }
  .reg .sat-grid {
    display: grid;
    gap: 20px;
    margin-top: 28px;
  }
  @media (min-width: 900px) {
    .reg .sat-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .reg .sat {
    background: var(--white);
    padding: 24px 24px 32px 34px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .reg .sat::before {
    content: "";
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--raspberry);
  }
  .reg .sat h3 {
    font-size: 28px;
    color: var(--brown);
  }
  .reg .sat .where {
    margin: 0;
    font-size: 15px;
    color: var(--gray-700);
  }
  .reg .sat ul {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
    font-size: 15px;
    line-height: 1.45;
  }
  .reg .sat li {
    padding-left: 18px;
    position: relative;
  }
  .reg .sat li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border: 2px solid var(--raspberry);
    border-radius: 50%;
  }
  .reg .sat .sat-cost {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--brown);
  }
  .reg .sat .sat-cost b {
    font: 700 28px var(--display);
    color: var(--brown);
  }
  .reg .sat .go {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
  }
  .reg .sat .go > a:not(.btn) {
    font-weight: 700;
    font-size: 15px;
  }
  .reg .sat .btn-primary {
    background: var(--raspberry);
  }
  .reg .sat .btn-primary:hover {
    background: var(--brown);
  }
  .reg .sat-note {
    margin-top: 18px;
  }

  /* Wednesday spotlight */
  .reg .wedspot {
    background: var(--raspberry);
    color: var(--white);
  }
  .reg .wedspot .kicker {
    color: var(--peach);
  }
  .reg .wedspot h2 {
    color: var(--white);
    font-size: clamp(34px, 5.5vw, 56px);
    margin-top: 10px;
  }
  .reg .wedspot .rule {
    color: var(--white);
    max-width: 360px;
    margin: 24px 0;
  }
  .reg .twin {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .reg .twin {
      grid-template-columns: 1fr 1fr;
    }
  }
  .reg .prog {
    background: rgba(255, 255, 255, 0.1);
    padding: 24px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .reg .prog > .kicker {
    color: var(--white);
  }
  .reg .wedspot blockquote {
    margin: 0;
    font: 500 clamp(21px, 2.3vw, 26px) / 1.3 var(--display);
  }
  .reg .prog .more {
    color: var(--white);
    font-weight: 700;
    margin-top: auto;
  }
  .reg .together {
    display: grid;
    gap: 18px 32px;
    margin-top: 28px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .reg .together {
      grid-template-columns: auto 1fr 1fr;
    }
  }
  .reg .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 28px;
    position: relative;
  }
  .reg .timeline::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 10px;
    bottom: 26px;
    border-left: 2px dashed rgba(255, 255, 255, 0.7);
  }
  .reg .timeline::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 8px;
    width: 14px;
    height: 14px;
    border: 2px solid var(--white);
    border-radius: 50%;
  }
  .reg .timeline li {
    position: relative;
    padding-bottom: 20px;
  }
  .reg .timeline li::before {
    content: "";
    position: absolute;
    left: -26px;
    top: 9px;
    width: 10px;
    height: 10px;
    background: var(--white);
    border-radius: 50%;
  }
  .reg .timeline time {
    display: block;
    font: 700 13px var(--body);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--peach);
  }
  .reg .timeline h3 {
    font-size: 22px;
    margin-top: 2px;
  }
  .reg .timeline p {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.45;
  }
  .reg .wedspot .also {
    font-size: 15px;
    color: var(--peach);
    margin: 0;
  }
  .reg .wedspot .choose {
    margin: 20px 0 0;
  }
  .reg .wedspot .btn-primary {
    background: var(--white);
    color: var(--raspberry);
  }
  .reg .wedspot .btn-primary:hover {
    background: var(--brown);
    color: var(--white);
  }

  /* Personas */
  .reg .doors {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  @media (min-width: 700px) {
    .reg .doors {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1000px) {
    .reg .doors {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .reg .door {
    background: var(--white);
    padding: 22px 20px 30px 26px;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .reg .door::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--orange-500);
  }
  .reg .door h3 {
    font-size: 23px;
    color: var(--orange-800);
  }
  .reg .door p {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }
  .reg .door-toggle {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 0 0;
    font: 700 15px var(--body);
    color: var(--raspberry);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .reg .door-toggle::after {
    content: "";
    width: 7px;
    height: 7px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s;
  }
  .reg .door.open .door-toggle::after {
    transform: translateY(2px) rotate(225deg);
  }
  /* Opens by animating the row from 0 to its content height. */
  .reg .door-more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s;
  }
  .reg .door.open .door-more {
    grid-template-rows: 1fr;
  }
  /* The padding keeps the buttons' focus rings inside the clipped area. */
  .reg .door-more > div {
    overflow: hidden;
    padding: 0 7px 7px;
    margin: 0 -7px -7px;
    visibility: hidden;
    transition: visibility 0s 0.25s;
  }
  .reg .door.open .door-more > div {
    visibility: visible;
    transition: none;
