---
import PageLayout from "../../../layouts/PageLayout.astro";
import { load_tsv } from "../../../utils/load_tsv";

const frontmatter = {
  title: "Accepted Papers",
  contact: "program@ieeevis.org",
  sidebar: "program",
  active_nav: "Program",
};

type PaperRow = {
  paper_id: string;
  paper_type: string;
  title: string;
  authors: string;
  session_name: string;
  location: string;
};

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const rows = load_tsv("./src/data/papers_list.tsv") as unknown as PaperRow[];

const sessions = rows.reduce(
  (acc, row) => {
    if (!row.title) {
      return acc;
    }
    if (!acc[row.session_name]) {
      acc[row.session_name] = [];
    }
    acc[row.session_name].push(row);
    return acc;
  },
  {} as Record<string, PaperRow[]>,
);
---

<PageLayout frontmatter={frontmatter}>
  <h1>Accepted Full Papers</h1>
  <p>
    Covering both IEEE VIS papers and TVCG papers to be presented at the
    conference.
  </p>

  {
    Object.entries(sessions).map(([name, papers]) => (
      <section>
        <h2 id={slugify(name)}>
          <a name={slugify(name)} />
          {name}
        </h2>

        {papers.map((paper) => (
          <p>
            <strong>
              {paper.title}

              {paper.paper_id.toLowerCase().includes("tvcg") && (
                <span class="text-sm opacity-70 ml-2"> (TVCG)</span>
              )}
            </strong>
            <br />
            {paper.authors}
            {paper.location && (
              <span class="text-sm opacity-70"> &middot; {paper.location}</span>
            )}
          </p>
        ))}
      </section>
    ))
  }
</PageLayout>
