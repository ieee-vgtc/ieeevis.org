---
import PageLayout from "../../../layouts/PageLayout.astro";
import { parse_tsv } from "../../../utils/load_tsv";

const frontmatter = {
  title: "VIS 2026 Jobs",
  description:
    "Job postings shared with the IEEE VIS 2026 community, and how to submit an opening to be listed during the conference.",
  active_nav: "Events & Community",
  sidebar: "community",
  contact: "community@ieeevis.org",
};

const JOBS_FORM_URL = "https://forms.gle/7JRMnv5Z9UwcQFuj6";
const JOBS_TSV_URL =
  "https://docs.google.com/spreadsheets/d/e/2PACX-1vSYnXidfmLWeFtmWpnmFnCyFzuf6wQh_9cS-lIbY1WwOY2HoEJXfP_bLRHE0DTYcCluhYdyU4GUvoDC/pub?output=tsv";

// One form submission describes a single employer, but may carry up to five
// separate openings, each in its own numbered block of columns.
const POSITION_SLOTS = [1, 2, 3, 4, 5];

type Job = {
  title: string;
  affiliation: string;
  type: string;
  contact: string;
  location: string;
  start: string;
  flexible: string;
  url: string;
};

/**
 * The sheet is a raw form response dump, so each header is the full question
 * text ("Position Type", "Locations 1 City, State/Province (optional)...").
 * Columns are matched on the leading question prefix so that editing a
 * question's help text in the form does not silently empty a column here.
 */
function cell(row: Record<string, string>, prefix: string): string {
  const key = Object.keys(row).find((header) => header.startsWith(prefix));
  return key ? row[key] : "";
}

/** Respondents often paste a bare domain rather than a full URL. */
function normalize_url(value: string): string {
  const url = value.trim();
  if (!url || /^https?:\/\//i.test(url)) {
    return url;
  }
  return url.includes(".") ? `https://${url}` : "";
}

async function load_jobs(): Promise<Job[]> {
  let tsv: string;
  try {
    const response = await fetch(JOBS_TSV_URL);
    if (!response.ok) {
      throw new Error(`${response.status} ${response.statusText}`);
    }
    tsv = await response.text();
  } catch (error) {
    // A build should not fail because the sheet was briefly unreachable; the
    // page falls back to its "no postings yet" state instead.
    console.warn(`[jobs] Could not fetch the job postings sheet: ${error}`);
    return [];
  }

  return parse_tsv(tsv).flatMap((row) => {
    const affiliation = cell(row, "Position Affiliation");
    const type = cell(row, "Position Type");
    const contact = cell(row, "Contact Information");

    return POSITION_SLOTS.map((slot) => ({
      title: cell(row, `Position Title ${slot}`),
      affiliation,
      type,
      contact,
      location: cell(row, `Locations ${slot}`),
      start: cell(row, `Starting Time ${slot}`),
      flexible: cell(row, `Is the starting time ${slot} flexible?`),
      url: normalize_url(cell(row, `Link/URL ${slot}`)),
    })).filter((job) => job.title);
  });
}

const jobs = await load_jobs();

// The form's "Position Type" wording is not fixed here, so sections are built
// from whatever answers come back, ordered to match how postings have been
// grouped in previous years. Anything unrecognized follows, alphabetically.
const SECTION_ORDER = ["student", "academ", "industr"];

function section_rank(type: string): number {
  const rank = SECTION_ORDER.findIndex((keyword) =>
    type.toLowerCase().includes(keyword),
  );
  return rank === -1 ? SECTION_ORDER.length : rank;
}

const sections = [...new Set(jobs.map((job) => job.type))]
  .sort((a, b) => section_rank(a) - section_rank(b) || a.localeCompare(b))
  .map((type) => ({
    heading: type || "Other",
    jobs: jobs.filter((job) => job.type === type),
  }));
---

<PageLayout frontmatter={frontmatter}>
  <h2>Welcome to the VIS 2026 site for job postings</h2>

  <p>
    We will collect job postings and display them here throughout the VIS 2026
    meeting.
  </p>

  <p>
    <a href={JOBS_FORM_URL}>VIS Community Job Posting Form</a>
  </p>

  <p>
    To submit a posting, please use the form above. Postings will be updated
    every couple of days on this page.
  </p>

  <h2>Job Postings</h2>

  {
    jobs.length === 0 ? (
      <p>
        No job postings have been submitted yet. Postings will appear here as
        they come in, so please check back closer to the conference — and if you
        are hiring, use the <a href={JOBS_FORM_URL}>form above</a> to be listed.
      </p>
    ) : (
      sections.map((section) => (
        <section class="mb-8">
          <h3>{section.heading}</h3>

          {section.jobs.map((job) => (
            <div class="mb-6">
              <h4 class="mb-1">
                {job.url ? (
                  <a href={job.url}>
                    {job.title} at {job.affiliation}
                  </a>
                ) : (
                  job.title
                )}
              </h4>

              <ul class="mt-0">
                {job.location && <li>Location: {job.location}</li>}
                {job.start && <li>Start date: {job.start}</li>}
                {job.flexible && <li>Start time flexible? {job.flexible}</li>}
                {job.contact && (
                  <li>
                    Contact:{" "}
                    {<a href={`mailto:${job.contact}`}>{job.contact}</a>}
                  </li>
                )}
              </ul>
            </div>
          ))}
        </section>
      ))
    )
  }

  <h2>Contact</h2>

  <p>
    For more information, contact IEEE VIS 2026 Community/Meetups/Elections
    Chairs:
  </p>

  <ul>
    <li>Kyle Hall, <em>Temple University</em></li>
    <li>Lijie Yao, <em>Xi’an Jiaotong-Liverpool University</em></li>
    <li>Carmen Hull, <em>Northeastern University</em></li>
  </ul>

  <p>
    email: <a href="mailto:community@ieeevis.org">community@ieeevis.org</a>
  </p>

