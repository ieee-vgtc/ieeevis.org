---
import ProgramHeader from "./ProgramHeader.astro";
import ProgramCard from "./ProgramCard.astro";
import {
  getDropdownGroups,
  getProgramEventTypeLabel,
  groupProgramTypeOptions,
  presentedResearchTypeLayout,
} from "../utils/programEventTypeLabel";

// Individual contributions are labeled differently from the sessions that hold them.
const contributionLabels: Record<string, string> = {
  associated: "Associated Event Papers",
  challenge: "Challenge Contributions",
  workshop: "Workshop Papers",
};
const getContributionLabel = (eventType: string) =>
  contributionLabels[eventType.toLowerCase()] ??
  getProgramEventTypeLabel(eventType);
import type { ProgramPapersBrowserProps } from "../types/programPaper";
import { typeColors, typeTextColors } from "../utils/week-of-utils";

// Day grouping matches the sessions page: days in the conference time zone.
const dayParts = (ms: number) => {
  if (!Number.isFinite(ms) || ms >= Number.MAX_SAFE_INTEGER) return null;
  const date = new Date(ms);
  const fmt = (options: Intl.DateTimeFormatOptions) =>
    new Intl.DateTimeFormat("en-US", {
      timeZone: "US/Eastern",
      ...options,
    }).format(date);
  const [month, day, year] = fmt({
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).split("/");
  return {
    key: `${year}-${month}-${day}`,
    weekday: fmt({ weekday: "long" }),
    date: fmt({ month: "short", day: "numeric" }),
  };
};

const toISO = (ms: number) =>
  Number.isFinite(ms) && ms < Number.MAX_SAFE_INTEGER
    ? new Date(ms).toISOString()
    : undefined;

const paperTypeToNameMap: Record<string, string> = {
  full: "Full VIS Paper",
  short: "VIS Short Paper",
  "cg&a": "CG&A Paper",
  poster: "Poster",
  demo: "Demo",
  associated: "Associated Event Paper",
  challenge: "Challenge Contribution",
  "computer graphics & applications": "CG&A Paper",
};

const normalizePaperType = (value: string) => value.trim().toLowerCase();
const getPaperType = (paper: ProgramPapersBrowserProps["papers"][number]) =>
  normalizePaperType(paper.presentationType || paper.presentationLabel);

const {
  papers,
  sessionRoles = [],
  storageKeyPrefix = "program-papers",
  itemType,
} = Astro.props as ProgramPapersBrowserProps;

const bookmarkKey = `${storageKeyPrefix}-bookmarks`;
const lowerItemType = itemType.toLowerCase();
const collectionPath = "/program/content/";

const typeCounts = papers.reduce<Record<string, number>>((acc, paper) => {
  const type = getPaperType(paper);
  acc[type] = (acc[type] || 0) + 1;
  return acc;
}, {});

// TVCG papers overlap with the other types, so they get their own pill
// (appended last) instead of being counted as a type.
const tvcgCount = papers.filter((paper) => paper.isTvcg).length;

// Award-winning papers (plus the awards plenary) also overlap with the other
// types, so they get a pill of their own.
// Workshop awards are listed separately so they don't mix with the main awards.
const isWorkshopAward = (paper: ProgramPapersBrowserProps["papers"][number]) =>
  Boolean(paper.award) && getPaperType(paper) === "workshop";
const awardCount = papers.filter(
  (paper) => (paper.award || paper.isAwardSession) && !isWorkshopAward(paper),
).length;
const workshopAwardCount = papers.filter(isWorkshopAward).length;

// Papers with an accessible PDF get their own pill too.
const accessibleCount = papers.filter(
  (paper) => paper.hasAccessiblePdf,
).length;

// Session chairs, organizers, and panelists ride along as their own "type" so they can be
// toggled like the paper types.
const sessionRoleType = "session-role";
const sessionRoleColor = "#e6e7e4";
const sessionRoleTextColor = "#212121";

const contributionOptions = Object.keys(typeCounts)
  .filter((value) => value !== "tvcg")
  .map((value) => ({
    value,
    label: getContributionLabel(value),
    count: typeCounts[value],
    color: typeColors[value] || "#6b7280",
  }))
  .sort((a, b) => a.label.localeCompare(b.label));

// Pill order and dropdown nesting come from presentedResearchTypeLayout.
const extraOptions = [
  {
    value: "tvcg",
    label: getProgramEventTypeLabel("tvcg"),
    count: tvcgCount,
    color: typeColors.tvcg,
  },
  {
    value: "awards",
    label: "Awards",
    count: awardCount,
    color: typeColors.awards,
  },
  {
    value: "workshop-awards",
    label: "Workshop Awards",
    count: workshopAwardCount,
    color: typeColors["workshop-awards"],
  },
  {
    value: "accessible",
    label: "Accessible PDFs",
    count: accessibleCount,
    color: typeColors.accessible,
  },
  {
    value: sessionRoleType,
    label: "Chairs, Organizers & Panelists",
    count: sessionRoles.length,
    color: typeColors["session-role"],
  },
].filter((option) => option.count > 0);

const typeOptions = groupProgramTypeOptions(
  [...contributionOptions, ...extraOptions],
  presentedResearchTypeLayout,
);
---

<section
  class="program-papers grid gap-3"
  data-local-storage-key-prefix={storageKeyPrefix}
  data-bookmark-key={bookmarkKey}
>
  <ProgramHeader
    title="Presented Research"
    subtitleBefore={`Browse accepted ${lowerItemType}s and posters by title, author, keyword, and session information.`}
    subtitleAfter={""}
    groupingNote="Note: bookmarks are stored locally in your browser and are not shared across devices."
    typeOptions={typeOptions}
    filterBarLabel="Paper type filters"
    allLabel="All"
    dropdownGroups={getDropdownGroups(presentedResearchTypeLayout)}
    timezoneLabel="Timezone display"
    timezoneSelectId="timezone-mode"
  >
    <Fragment slot="primary-controls">
      <label class="u-control">
        Search by
        <div
          id="papers-search-field"
          class="papers-choice-group u-responsive-choice-group"
          role="group"
          aria-label="Search by"
        >
          <select
            class="u-select u-mobile-choice-select"
            data-choice-select
            aria-label="Search by"
          >
            <option value="any">any</option>
            <option value="title">title</option>
            <option value="keyword">keyword</option>
            <option value="abstract">abstract</option>
            <option value="author">author</option>
            <option value="institution">institution</option>
            <option value="session">session</option>
          </select>
          <button
            type="button"
            class="papers-choice-button hover-response--tint is-active"
            data-choice-value="any"
            aria-pressed="true"
          >
            any
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="title"
            aria-pressed="false"
          >
            title
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="keyword"
            aria-pressed="false"
          >
            keyword
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="abstract"
            aria-pressed="false"
          >
            abstract
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="author"
            aria-pressed="false"
          >
            author
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="institution"
            aria-pressed="false"
          >
            institution
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="session"
            aria-pressed="false"
          >
            session
          </button>
        </div>
      </label>

      <label class="u-control">
        Sort by
        <div
          id="papers-sort"
          class="papers-choice-group u-responsive-choice-group"
          role="group"
          aria-label="Sort by"
        >
          <select
            class="u-select u-mobile-choice-select"
            data-choice-select
            aria-label="Sort by"
          >
            <option value="title">title</option>
            <option value="bookmarked">bookmarked first</option>
            <option value="schedule">schedule</option>
          </select>
          <button
            type="button"
            class="papers-choice-button hover-response--tint is-active"
            data-choice-value="title"
            aria-pressed="true"
          >
            title
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="bookmarked"
            aria-pressed="false"
          >
            bookmarked first
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="schedule"
            aria-pressed="false"
          >
            schedule
          </button>
        </div>
      </label>

      <label class="u-control">
        Show by
        <div
          id="papers-view"
          class="papers-choice-group u-responsive-choice-group"
          role="group"
          aria-label="Show by"
        >
          <select
            class="u-select u-mobile-choice-select"
            data-choice-select
            aria-label="Show by"
          >
            <option value="list">list</option>
            <option value="time">time</option>
          </select>
          <button
            type="button"
            class="papers-choice-button hover-response--tint is-active"
            data-choice-value="list"
            aria-pressed="true"
          >
            list
          </button>
          <button
            type="button"
            class="papers-choice-button hover-response--tint"
            data-choice-value="time"
            aria-pressed="false"
          >
            time
          </button>
        </div>
      </label>
    </Fragment>
    <div slot="extra-controls" class="papers-controls">
      <label class="papers-control">
        Find
        <div class="papers-search-shell">
          <input
            id="papers-search"
            class="papers-search"
            type="search"
            placeholder={`Search ${lowerItemType}s`}
            aria-label={`Search ${lowerItemType}s`}
          />
          <button
            id="papers-search-clear"
            class="papers-search-clear"
            type="button"
            aria-label="Clear search"
          >
            x
          </button>
        </div>
      </label>
    </div>
  </ProgramHeader>

  <div class="papers-grid" id="papers-grid">
    {
      papers.map((paper) => {
        const isBookmarked = false;
        const normalizedType = getPaperType(paper);
        const colorType = paper.isTvcg ? "tvcg" : normalizedType;
        const groupLabel = paper.sessionKey
          ? "session"
          : normalizedType === "workshop"
            ? "workshop"
            : "event";
        const groupHref = paper.sessionKey
          ? `${collectionPath}?session=${encodeURIComponent(paper.sessionKey)}&filter=session&search=${encodeURIComponent(paper.sessionLabel)}`
          : paper.eventKey
            ? `${collectionPath}?event=${encodeURIComponent(paper.eventKey)}&search=${encodeURIComponent(paper.eventLabel)}`
            : undefined;
        const people = paper.authorNames.map((authorName) => ({
          name: authorName,
          href: `${collectionPath}?filter=author&search=${encodeURIComponent(authorName)}`,
        }));
        const links = [
          ...(paper.sessionUrl
            ? [
                {
                  label: paper.scheduleLabel,
                  startISO: toISO(paper.startMs),
                  labelSuffix: ` - ${paper.sessionLabel}`,
                  href: paper.sessionUrl,
                  icon: "schedule",
                },
              ]
            : []),
          // {
          //   label: `Search for ${lowerItemType}s in this ${groupLabel}`,
          //   href: groupHref,
          //   icon: "search",
          //   disabledTitle: groupHref
          //     ? undefined
          //     : `Session and event information are not available for this ${lowerItemType}`,
          // },
        ];

        return (
          <ProgramCard
            data-program-card
            data-paper-id={paper.id}
            data-type={normalizedType}
            data-tvcg={paper.isTvcg ? "true" : "false"}
            data-accessible={paper.hasAccessiblePdf ? "true" : "false"}
            data-awards={
              (paper.award || paper.isAwardSession) && !isWorkshopAward(paper)
                ? "true"
                : "false"
            }
            data-workshop-awards={isWorkshopAward(paper) ? "true" : "false"}
            data-title={paper.title.toLowerCase()}
            data-authors={paper.authorNames.join(",").toLowerCase()}
            data-keywords={paper.keywordsLabel.toLowerCase()}
            data-keywords-label={paper.keywordsLabel}
            data-institutions={(paper.institutions || []).join("|")}
            data-abstract={
              paper.abstractText === "Abstract not available."
                ? ""
                : paper.abstractText
            }
            data-session={paper.sessionLabel.toLowerCase()}
            data-session-key={paper.sessionKey || ""}
            data-event={paper.eventLabel.toLowerCase()}
            data-event-key={paper.eventKey || ""}
            data-award={paper.award?.toLowerCase() || ""}
            data-start-ms={paper.startMs}
            data-day={dayParts(paper.startMs)?.key || ""}
            data-day-weekday={dayParts(paper.startMs)?.weekday || ""}
            data-day-date={dayParts(paper.startMs)?.date || ""}
            accentColor={typeColors[colorType] || "#f3f4f6"}
            titleColor={typeTextColors[colorType] || "#111827"}
            title={paper.title}
            titleHref={paper.titleHref || `/program/content/${paper.id}`}
            eyebrow={
              paper.eyebrow ||
              (paper.isTvcg
                ? "TVCG Paper"
                : paperTypeToNameMap[normalizedType] || paper.presentationLabel)
            }
            award={paper.award}
            accessible={paper.hasAccessiblePdf}
            peopleLabel={paper.titleHref ? "Speakers" : "Authors"}
            people={people}
            links={links}
            bookmark={
              paper.titleHref ? undefined : { bookmarked: isBookmarked }
            }
          >
            <div class="program-card__match" data-match hidden />
          </ProgramCard>
        );
      })
    }
    {
      sessionRoles.map((sessionRole) => (
        <ProgramCard
          data-program-card
          data-session-role
          data-type={sessionRoleType}
          data-title={sessionRole.sessionTitle.toLowerCase()}
          data-authors={sessionRole.people.join(",").toLowerCase()}
          data-people={sessionRole.people.join("|").toLowerCase()}
          data-session={sessionRole.sessionTitle.toLowerCase()}
          data-start-ms={sessionRole.startMs}
          data-day={dayParts(sessionRole.startMs)?.key || ""}
          data-day-weekday={dayParts(sessionRole.startMs)?.weekday || ""}
          data-day-date={dayParts(sessionRole.startMs)?.date || ""}
          accentColor={sessionRoleColor}
          titleColor={sessionRoleTextColor}
          title={sessionRole.sessionTitle}
          titleHref={sessionRole.sessionUrl}
          eyebrow={sessionRole.roleLabel}
          peopleLabel={`${sessionRole.role}${sessionRole.people.length > 1 ? "s" : ""}`}
          people={sessionRole.people.map((name) => ({
            name,
            href: `${collectionPath}?filter=author&search=${encodeURIComponent(name)}`,
          }))}
          links={[
            {
              label: `${sessionRole.scheduleLabel} - ${sessionRole.roomName}`,
              startISO: toISO(sessionRole.startMs),
              labelSuffix: ` - ${sessionRole.roomName}`,
              href: sessionRole.sessionUrl,
              icon: "schedule",
            },
          ]}
        />
      ))
    }
  </div>

  <p id="papers-empty" class="papers-empty" hidden>
    No papers match the current filters.
  </p>
</section>

<script>
  import {
    createUrlStateHistory,
    type UrlStateWriteOptions,
  } from "../utils/urlStateHistory";

  (() => {
    const root = document.querySelector(".program-papers");
    if (!root) return;

    const bookmarkKey =
      root.getAttribute("data-bookmark-key") || "program-papers-bookmarks";

    const searchInput = root.querySelector<HTMLInputElement>("#papers-search");
    const clearButton = root.querySelector<HTMLButtonElement>(
      "#papers-search-clear",
    );
    const searchFieldControl = root.querySelector<HTMLElement>(
      "#papers-search-field",
    );
    const sortControl = root.querySelector<HTMLElement>("#papers-sort");
    const grid = root.querySelector<HTMLElement>("#papers-grid");
    const emptyState = root.querySelector<HTMLElement>("#papers-empty");
    const cards = Array.from(
      root.querySelectorAll<HTMLElement>("[data-program-card]"),
    );
    const typeFilterButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-type-filter]"),
    );
    let requestedSessionKey = "";
    let requestedEventKey = "";
    const validSearchFields = new Set([
      "any",
      "title",
      "keyword",
      "abstract",
      "author",
      "institution",
      "session",
    ]);
    const validTypeValues = new Set(
      typeFilterButtons
        .map((button) => button.getAttribute("data-type-filter") || "")
        .filter(Boolean),
    );
    const validSortModes = new Set(["title", "bookmarked", "schedule"]);
    const viewControl = root.querySelector<HTMLElement>("#papers-view");

    const getStoredBookmarks = () => {
      try {
        const raw = localStorage.getItem(bookmarkKey);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    const storeBookmarks = (bookmarks: string[]) => {
      localStorage.setItem(bookmarkKey, JSON.stringify(bookmarks));
    };

    const bookmarks = new Set(getStoredBookmarks());

    const getChoiceValue = (
      container: HTMLElement | null,
      fallback: string,
    ): string => {
      if (!container) return fallback;
      const select = container.querySelector<HTMLSelectElement>(
        "[data-choice-select]",
      );
      if (select) return select.value || fallback;
      const activeButton = container.querySelector<HTMLButtonElement>(
        ".papers-choice-button.is-active[data-choice-value]",
      );
      return activeButton?.dataset.choiceValue || fallback;
    };

    const setChoiceValue = (
      container: HTMLElement | null,
      value: string,
    ): boolean => {
      if (!container) return false;
      const buttons = Array.from(
        container.querySelectorAll<HTMLButtonElement>(
          ".papers-choice-button[data-choice-value]",
        ),
      );
      const select = container.querySelector<HTMLSelectElement>(
        "[data-choice-select]",
      );
      let found = false;

      for (const button of buttons) {
        const isActive = button.dataset.choiceValue === value;
        if (isActive) found = true;
        button.classList.toggle("is-active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      }

      if (
        select &&
        Array.from(select.options).some((option) => option.value === value)
      ) {
        select.value = value;
        found = true;
      }

      return found;
    };

    let activeTypeFilter = "all";

    const restoreFromUrl = (params: URLSearchParams) => {
      setChoiceValue(
        viewControl,
        params.get("view") === "time" ? "time" : "list",
      );
      requestedSessionKey = params.get("session") || "";
      requestedEventKey = params.get("event") || "";
      if (searchInput) {
        searchInput.value = params.get("search") || "";
      }

      const urlSearchField = params.get("filter") || "";
      setChoiceValue(
        searchFieldControl,
        validSearchFields.has(urlSearchField) ? urlSearchField : "any",
      );

      const urlType = params.get("type") || "";
      activeTypeFilter = validTypeValues.has(urlType) ? urlType : "all";

      const urlSortMode = params.get("sort") || "";
      setChoiceValue(
        sortControl,
        validSortModes.has(urlSortMode) ? urlSortMode : "title",
      );
    };

    restoreFromUrl(new URLSearchParams(window.location.search));

    const getSearchQuery = () =>
      searchInput instanceof HTMLInputElement
        ? searchInput.value.trim().toLowerCase()
        : "";

    const getSearchField = () => getChoiceValue(searchFieldControl, "any");

    const getSortMode = () => getChoiceValue(sortControl, "title");

    const getViewMode = () => getChoiceValue(viewControl, "list");

    const getTypeFilter = () => activeTypeFilter;

    const syncUrlParams = (options?: UrlStateWriteOptions) => {
      const nextParams = new URLSearchParams(window.location.search);
      const searchQuery = getSearchQuery();
      const searchField = getSearchField();
      const typeFilter = getTypeFilter();
      const sortMode = getSortMode();

      if (requestedSessionKey) {
        nextParams.set("session", requestedSessionKey);
      } else {
        nextParams.delete("session");
      }

      if (requestedEventKey) {
        nextParams.set("event", requestedEventKey);
      } else {
        nextParams.delete("event");
      }

      if (searchQuery) {
        nextParams.set("search", searchQuery);
      } else {
        nextParams.delete("search");
      }

      if (searchField !== "any") {
        nextParams.set("filter", searchField);
      } else {
        nextParams.delete("filter");
      }

      if (typeFilter !== "all") {
        nextParams.set("type", typeFilter);
      } else {
        nextParams.delete("type");
      }

      if (getViewMode() === "time") {
        nextParams.set("view", "time");
      } else {
        nextParams.delete("view");
      }

      if (sortMode !== "title") {
        nextParams.set("sort", sortMode);
      } else {
        nextParams.delete("sort");
      }

      urlHistory.write(nextParams, options);
    };

    // Abstracts are long; lowercase each once instead of on every keystroke.
    const lowerAbstracts = new WeakMap<HTMLElement, string>();
    const getLowerAbstract = (card: HTMLElement) => {
      let value = lowerAbstracts.get(card);
      if (value === undefined) {
        value = (card.dataset.abstract || "").toLowerCase();
        lowerAbstracts.set(card, value);
      }
      return value;
    };

    const getLowerInstitutions = (card: HTMLElement) =>
      (card.dataset.institutions || "").toLowerCase();

    const getFieldValue = (card: HTMLElement) => {
      const field = getSearchField();
      if (field === "title") return card.dataset.title || "";
      if (field === "keyword") return card.dataset.keywords || "";
      if (field === "abstract") return getLowerAbstract(card);
      if (field === "author") return card.dataset.authors || "";
      if (field === "institution") return getLowerInstitutions(card);
      if (field === "session") return card.dataset.session || "";
      return [
        card.dataset.title || "",
        card.dataset.authors || "",
        card.dataset.keywords || "",
        getLowerAbstract(card),
        getLowerInstitutions(card),
        card.dataset.session || "",
        card.dataset.event || "",
        card.dataset.award || "",
      ].join(" ");
    };

    const refreshBookmarkState = () => {
      for (const card of cards) {
        const paperId = card.getAttribute("data-paper-id");
        const toggle = card.querySelector<HTMLButtonElement>(
          "[data-bookmark-toggle]",
        );
        const icon = card.querySelector<HTMLElement>("[data-bookmark-icon]");
        if (!paperId || !toggle) continue;

        const bookmarked = bookmarks.has(paperId);
        toggle.setAttribute(
          "aria-label",
          bookmarked ? "Remove bookmark" : "Add bookmark",
        );
        toggle.setAttribute(
          "title",
          bookmarked ? "Remove bookmark" : "Add bookmark",
        );
        toggle.setAttribute("data-bookmarked", String(bookmarked));
        toggle.classList.toggle("is-bookmarked", bookmarked);
        if (icon) {
          icon.textContent = bookmarked ? "bookmark" : "bookmark_border";
        }
      }
    };

    const refreshTypeFilterState = () => {
      for (const button of typeFilterButtons) {
        const buttonType = button.getAttribute("data-type-filter") || "all";
        const isActive = buttonType === activeTypeFilter;
        button.setAttribute("aria-pressed", String(isActive));
        button.classList.toggle("is-active", isActive);
      }
      // Flag dropdowns holding the active option, and show it on the toggle.
      root
        .querySelectorAll<HTMLElement>(".u-filter-menu")
        .forEach((menu) => {
          const active = menu.querySelector<HTMLElement>(
            ".u-filter-pill.is-active",
          );
          menu.classList.toggle("has-active", Boolean(active));
          const label = menu.querySelector<HTMLElement>(
            ".u-filter-menu__active",
          );
          const name = active?.querySelector("span")?.textContent;
          if (label) label.textContent = name ? `: ${name}` : "";
        });
    };

    // Under "All", a chair/organizer card only appears when the search names
    // that person; very short queries would match nearly everyone.
    const matchesSessionRolePerson = (card: HTMLElement, query: string) => {
      const field = getSearchField();
      return (
        (field === "any" || field === "author") &&
        query.length >= 3 &&
        (card.dataset.people || "")
          .split("|")
          .some((name) => name.includes(query))
      );
    };

    // Explain keyword/abstract hits on a card: matching keywords become chips
    // and the abstract shows a highlighted excerpt around the first match.
    const renderMatchReasons = (card: HTMLElement, query: string) => {
      const box = card.querySelector<HTMLElement>("[data-match]");
      if (!box) return;
      box.replaceChildren();
      const field = getSearchField();
      const searchKeywords = field === "any" || field === "keyword";
      const searchInstitutions = field === "any" || field === "institution";
      const searchAbstract = field === "any" || field === "abstract";
      if (!query || card.hasAttribute("data-session-role")) {
        box.hidden = true;
        return;
      }

      const highlight = (text: string, parent: HTMLElement) => {
        const lower = text.toLowerCase();
        let from = 0;
        for (let at = lower.indexOf(query); at !== -1; at = lower.indexOf(query, from)) {
          parent.append(text.slice(from, at));
          const mark = document.createElement("mark");
          mark.className = "program-card__mark";
          mark.textContent = text.slice(at, at + query.length);
          parent.append(mark);
          from = at + query.length;
        }
        parent.append(text.slice(from));
      };

      const addRow = (label: string, icon: string) => {
        const row = document.createElement("p");
        row.className = "program-card__match-row";
        const tag = document.createElement("span");
        tag.className = "program-card__match-tag";
        tag.title = `Matched in ${label.toLowerCase()}`;
        const iconEl = document.createElement("i");
        iconEl.className = "material-icons";
        iconEl.setAttribute("aria-hidden", "true");
        iconEl.textContent = icon;
        tag.append(iconEl, label);
        row.append(tag);
        box.append(row);
        return row;
      };

      if (searchKeywords && card.dataset.keywords?.includes(query)) {
        const matched = (card.dataset.keywordsLabel || "")
          .split(", ")
          .filter((keyword) => keyword.toLowerCase().includes(query));
        const row = addRow("Keyword", "sell");
        for (const keyword of matched) {
          const chip = document.createElement("span");
          chip.className = "program-card__match-chip";
          highlight(keyword, chip);
          row.append(chip);
        }
      }

      if (searchInstitutions && getLowerInstitutions(card).includes(query)) {
        const matched = (card.dataset.institutions || "")
          .split("|")
          .filter((name) => name.toLowerCase().includes(query));
        const row = addRow("Institution", "school");
        for (const name of matched) {
          const chip = document.createElement("span");
          chip.className = "program-card__match-chip";
          highlight(name, chip);
          row.append(chip);
        }
      }

      const abstract = card.dataset.abstract || "";
      const abstractAt = searchAbstract
        ? getLowerAbstract(card).indexOf(query)
        : -1;
      if (abstractAt !== -1) {
        const start = Math.max(0, abstractAt - 70);
        const end = Math.min(abstract.length, abstractAt + query.length + 110);
        const row = addRow("Abstract", "notes");
        const excerpt = document.createElement("span");
        excerpt.className = "program-card__match-excerpt";
        highlight(
          `${start > 0 ? "…" : ""}${abstract.slice(start, end)}${end < abstract.length ? "…" : ""}`,
          excerpt,
        );
        row.append(excerpt);
      }

      box.hidden = box.childElementCount === 0;
    };

    const applyFilters = (options?: UrlStateWriteOptions) => {
      const query = getSearchQuery();
      const typeFilter = getTypeFilter();
      const timeView = getViewMode() === "time";
      const sortMode = timeView ? "schedule" : getSortMode();
      const visibleCards = cards.filter((card) => {
        const haystack = getFieldValue(card);
        const cardType = card.dataset.type || "";
        const typeMatch =
          typeFilter === "all" ||
          (typeFilter === "tvcg"
            ? card.dataset.tvcg === "true"
            : typeFilter === "awards"
              ? card.dataset.awards === "true"
              : typeFilter === "workshop-awards"
                ? card.dataset.workshopAwards === "true"
              : typeFilter === "accessible"
                ? card.dataset.accessible === "true"
                : cardType === typeFilter);
        const sessionMatch =
          requestedSessionKey.length === 0 ||
          card.dataset.sessionKey === requestedSessionKey;
        const eventMatch =
          requestedEventKey.length === 0 ||
          card.dataset.eventKey === requestedEventKey;
        if (typeFilter === "all" && card.hasAttribute("data-session-role")) {
          return (
            matchesSessionRolePerson(card, query) && sessionMatch && eventMatch
          );
        }
        return (
          (query.length === 0 || haystack.includes(query)) &&
          typeMatch &&
          sessionMatch &&
          eventMatch
        );
      });

      visibleCards.sort((a, b) => {
        // Keep a person's chair/organizer roles ahead of their papers.
        const roleDelta =
          Number(b.hasAttribute("data-session-role")) -
          Number(a.hasAttribute("data-session-role"));
        if (!timeView && roleDelta !== 0) return roleDelta;

        // On the awards view, list best awards, then honorable mentions,
        // then everything else (e.g. the awards session itself).
        if (typeFilter === "awards") {
          const awardRank = (card: HTMLElement) => {
            const award = card.dataset.award || "";
            if (!award) return 2;
            return award.includes("honorable") ? 1 : 0;
          };
          const rankDelta = awardRank(a) - awardRank(b);
          if (rankDelta !== 0) return rankDelta;

          // Group by type within each tier: full, then short, then the rest.
          const typeOrder = ["full", "short"];
          const typeRank = (card: HTMLElement) => {
            const index = typeOrder.indexOf(card.dataset.type || "");
            return index === -1 ? typeOrder.length : index;
          };
          const typeDelta = typeRank(a) - typeRank(b);
          if (typeDelta !== 0) return typeDelta;
          const typeNameDelta = (a.dataset.type || "").localeCompare(
            b.dataset.type || "",
          );
          if (typeNameDelta !== 0) return typeNameDelta;
        }

        const aId = a.getAttribute("data-paper-id") || "";
        const bId = b.getAttribute("data-paper-id") || "";

        if (sortMode === "bookmarked") {
          const delta = Number(bookmarks.has(bId)) - Number(bookmarks.has(aId));
          if (delta !== 0) return delta;
        }

        if (sortMode === "schedule") {
          const aStart = Number(
            a.getAttribute("data-start-ms") || Number.MAX_SAFE_INTEGER,
          );
          const bStart = Number(
            b.getAttribute("data-start-ms") || Number.MAX_SAFE_INTEGER,
          );
          if (aStart !== bStart) return aStart - bStart;
        }

        const aTitle = a.getAttribute("data-title") || "";
        const bTitle = b.getAttribute("data-title") || "";
        return aTitle.localeCompare(bTitle);
      });

      if (grid) {
        grid.querySelectorAll(".papers-day-header").forEach((el) => el.remove());
        grid.classList.toggle("is-grouped-by-time", timeView);
        let currentDay: string | null = null;
        for (const card of visibleCards) {
          if (timeView) {
            const day = card.dataset.day || "";
            if (day !== currentDay) {
              currentDay = day;
              const header = document.createElement("header");
              header.className = "sessions-day-header papers-day-header";
              const heading = document.createElement("h2");
              heading.textContent = day
                ? card.dataset.dayWeekday || day
                : "Time TBA";
              header.append(heading);
              if (day) {
                const note = document.createElement("p");
                note.textContent = card.dataset.dayDate || "";
                header.append(note);
              }
              grid.appendChild(header);
            }
          }
          grid.appendChild(card);
        }
      }

      const visibleSet = new Set(visibleCards);
      for (const card of cards) {
        card.hidden = !visibleSet.has(card);
        if (visibleSet.has(card)) renderMatchReasons(card, query);
      }

      if (emptyState) {
        emptyState.hidden = visibleCards.length > 0;
      }

      refreshBookmarkState();
      syncUrlParams(options);
    };

    const urlHistory = createUrlStateHistory((params) => {
      restoreFromUrl(params);
      refreshTypeFilterState();
      applyFilters();
    });

    const toggleBookmark = (paperId: string) => {
      if (bookmarks.has(paperId)) {
        bookmarks.delete(paperId);
      } else {
        bookmarks.add(paperId);
      }
      storeBookmarks(Array.from(bookmarks));
      refreshBookmarkState();
    };

    for (const card of cards) {
      const paperId = card.getAttribute("data-paper-id");
      const toggle = card.querySelector<HTMLButtonElement>(
        "[data-bookmark-toggle]",
      );

      if (toggle && paperId) {
        toggle.addEventListener("click", () => toggleBookmark(paperId));
      }
    }

    if (searchInput instanceof HTMLInputElement) {
      let searchTimer: number | undefined;
      searchInput.addEventListener("input", () => {
        requestedSessionKey = "";
        requestedEventKey = "";
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(
          () => applyFilters({ burst: "search" }),
          150,
        );
      });
    }

    if (clearButton) {
      clearButton.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
        }
        requestedSessionKey = "";
        requestedEventKey = "";
        applyFilters();
      });
    }

    if (searchFieldControl) {
      const searchFieldButtons = Array.from(
        searchFieldControl.querySelectorAll<HTMLButtonElement>(
          ".papers-choice-button[data-choice-value]",
        ),
      );
      for (const button of searchFieldButtons) {
        button.addEventListener("click", () => {
          const value = button.dataset.choiceValue;
          const previousValue = getSearchField();
          if (!value || !setChoiceValue(searchFieldControl, value)) return;
          if (value !== previousValue) {
            requestedSessionKey = "";
            requestedEventKey = "";
          }
          applyFilters();
        });
      }
      const searchFieldSelect =
        searchFieldControl.querySelector<HTMLSelectElement>(
          "[data-choice-select]",
        );
      searchFieldSelect?.addEventListener("change", () => {
        if (!setChoiceValue(searchFieldControl, searchFieldSelect.value)) {
          return;
        }
        requestedSessionKey = "";
        requestedEventKey = "";
        applyFilters();
      });
    }

    for (const button of typeFilterButtons) {
      button.addEventListener("click", () => {
        activeTypeFilter = button.getAttribute("data-type-filter") || "all";
        refreshTypeFilterState();
        applyFilters();
      });
    }

    if (viewControl) {
      const viewButtons = Array.from(
        viewControl.querySelectorAll<HTMLButtonElement>(
          ".papers-choice-button[data-choice-value]",
        ),
      );
      for (const button of viewButtons) {
        button.addEventListener("click", () => {
          const value = button.dataset.choiceValue;
          if (!value || !setChoiceValue(viewControl, value)) return;
          applyFilters();
        });
      }
      const viewSelect = viewControl.querySelector<HTMLSelectElement>(
        "[data-choice-select]",
      );
      viewSelect?.addEventListener("change", () => {
        if (!setChoiceValue(viewControl, viewSelect.value)) return;
        applyFilters();
      });
    }

    if (sortControl) {
      const sortButtons = Array.from(
        sortControl.querySelectorAll<HTMLButtonElement>(
          ".papers-choice-button[data-choice-value]",
        ),
      );
      for (const button of sortButtons) {
        button.addEventListener("click", () => {
          const value = button.dataset.choiceValue;
          if (!value || !setChoiceValue(sortControl, value)) return;
          applyFilters();
        });
      }
      const sortSelect = sortControl.querySelector<HTMLSelectElement>(
        "[data-choice-select]",
      );
      sortSelect?.addEventListener("change", () => {
        if (!setChoiceValue(sortControl, sortSelect.value)) return;
        applyFilters();
      });
    }

    refreshTypeFilterState();
    refreshBookmarkState();
    applyFilters({ replace: true });
  })();
</script>

<script>
  import {
    TIMEZONE_MODE_EVENT,
    getSavedTimezoneMode,
    instantPartsForMode,
    isTimezoneMode,
    renderTimeParts,
    saveTimezoneMode,
    type TimezoneMode,
  } from "../utils/timezoneMode";

  const control = document.querySelector<HTMLElement>("#timezone-mode");
  const buttons = Array.from(
    control?.querySelectorAll<HTMLButtonElement>("[data-choice-value]") ?? [],
  );
  const select = control?.querySelector<HTMLSelectElement>(
    "[data-choice-select]",
  );

  const render = (mode: TimezoneMode) => {
    for (const button of buttons) {
      const active = button.dataset.choiceValue === mode;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    }
    if (select) select.value = mode;
    for (const node of document.querySelectorAll<HTMLElement>(
      "[data-tz-instant]",
    )) {
      renderTimeParts(
        node,
        instantPartsForMode(
          node.dataset.tzInstant!,
          mode,
          node.dataset.tzConference || "US/Eastern",
        ),
      );
    }
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const value = button.dataset.choiceValue;
      if (isTimezoneMode(value)) saveTimezoneMode(value);
    });
  }
  select?.addEventListener("change", () => {
    if (isTimezoneMode(select.value)) saveTimezoneMode(select.value);
  });
  window.addEventListener(TIMEZONE_MODE_EVENT, (event) =>
    render((event as CustomEvent<TimezoneMode>).detail),
  );
  render(getSavedTimezoneMode());
</script>
