---
import AwardBadge from "./AwardBadge.astro";
import AccessibleBadge from "./AccessibleBadge.astro";
import { withBaseURL } from "../utils/withBaseURL";

type Props = {
  title: string;
  titleHref: string;
  eyebrow?: string;
  subtitle?: string;
  award?: string | null;
  accessible?: boolean;
  peopleLabel?: string;
  people?: { name: string; href?: string }[];
  notes?: string[];
  /** Schedule text; pages rewrite `.js-time-range` for the timezone setting. */
  scheduleLabel?: string;
  links?: {
    label: string;
    href?: string;
    icon?: string;
    disabledTitle?: string;
    /** Start time the label begins with; rewritten for the timezone setting. */
    startISO?: string;
    /** Label text following the time, e.g. " - Session title". */
    labelSuffix?: string;
  }[];
  bookmark?: {
    bookmarked: boolean;
  };
  accentColor?: string;
  titleColor?: string;
  class?: string;
  [key: string]: unknown;
};

const {
  title,
  titleHref,
  eyebrow,
  subtitle,
  award,
  accessible = false,
  peopleLabel,
  people = [],
  notes = [],
  scheduleLabel,
  links = [],
  bookmark,
  accentColor = "#6b7280",
  titleColor,
  class: className,
  ...attrs
} = Astro.props as Props;

const classList = ["program-card", className].filter(Boolean).join(" ");

const style = [
  `--program-card-accent: ${accentColor}`,
  titleColor ? `--program-card-title: ${titleColor}` : "",
]
  .filter(Boolean)
  .join("; ");
---

<article class={classList} style={style} {...attrs}>
  <div class="program-card__header">
    {
      bookmark && (
        <button
          class="program-card__bookmark"
          type="button"
          data-bookmark-toggle
          aria-label={bookmark.bookmarked ? "Remove bookmark" : "Add bookmark"}
          title={bookmark.bookmarked ? "Remove bookmark" : "Add bookmark"}
          data-bookmarked={bookmark.bookmarked ? "true" : "false"}
        >
          <i
            class="material-icons"
            data-bookmark-icon
            style={`color: ${titleColor}`}
          >
            {bookmark.bookmarked ? "bookmark" : "bookmark_border"}
          </i>
        </button>
      )
    }

    {
      eyebrow && (
        <p class="program-card__eyebrow" style={`color: ${titleColor}`}>
          {eyebrow}
        </p>
      )
    }

    <div class="program-card__title">
      <a
        class="program-card__title-link"
        href={withBaseURL(titleHref)}
        style={`color: ${titleColor || "inherit"}`}
      >
        {title}
      </a>
    </div>

    {subtitle && <p class="program-card__subtitle">{subtitle}</p>}

    {
      award && (
        <div class="program-card__award">
          <AwardBadge award={award} compact />
        </div>
      )
    }

    {
      accessible && (
        <div class="program-card__award">
          <AccessibleBadge compact />
        </div>
      )
    }
  </div>

  <div class="program-card__body">
    {
      people.length > 0 && (
        <p class="program-card__people">
          {peopleLabel && (
            <span class="program-card__people-label">{peopleLabel}: </span>
          )}
          <span class="program-card__people-values">
            {people.map((person, index) => (
              <span>
                {index > 0 && <span>, </span>}
                {person.href ? (
                  <a
                    class="program-card__person-link"
                    href={withBaseURL(person.href)}
                  >
                    {person.name}
                  </a>
                ) : (
                  person.name
                )}
              </span>
            ))}
          </span>
        </p>
      )
    }
    <div>
      {notes.map((note) => <p class="program-card__note">{note}</p>)}
      {
        scheduleLabel && (
          <p class="program-card__note">
            Schedule: <span class="js-time-range">{scheduleLabel}</span>
          </p>
        )
      }

      {
        links.length > 0 && (
          <p class="program-card__links flex flex-col">
            {links.map((link) => (
              <span class="program-card__action">
                {link.icon && (
                  <i
                    class="material-icons program-card__action-icon"
                    aria-hidden="true"
                  >
                    {link.icon}
                  </i>
                )}
                {link.href ? (
                  <a
                    class="program-card__action-link"
                    href={withBaseURL(link.href)}
                  >
                    {link.startISO ? (
                      <>
                        <span
                          data-tz-instant={link.startISO}
                          data-tz-conference="US/Eastern"
                        >
                          {link.label.slice(
                            0,
                            link.label.length - (link.labelSuffix?.length ?? 0),
                          )}
                        </span>
                        {link.labelSuffix}
                      </>
                    ) : (
                      link.label
                    )}
                  </a>
                ) : (
                  <span
                    class="program-card__action-link program-card__link--disabled"
                    aria-disabled="true"
                    title={link.disabledTitle}
                  >
                    {link.label}
                  </span>
                )}
              </span>
            ))}
          </p>
        )
      }
    </div>
  </div>
</article>
