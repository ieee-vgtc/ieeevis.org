---
/**
 * Wraps a single piece of content (a PDF link, a video embed) that should
 * only render for signed-in attendees.
 *
 * The paper/poster pages this sits on are fully static (no server), so there
 * is no session to check at build time: both the prompt and the gated
 * content are always in the markup, and a client script shows whichever one
 * matches the reader's actual Auth0 sign-in state once it has checked
 * (src/lib/auth0Client.ts). The prompt is what the page shows by default —
 * correct for the common case of a signed-out visitor, and avoiding a flash
 * of gated content for a signed-in one.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="auth-gate" data-auth-gate role="note">
  <svg
    class="auth-gate__icon"
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <rect x="3" y="11" width="18" height="10" rx="2" />
    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
  </svg>
  <p class="auth-gate__text">Sign in to access the {label}.</p>
  <button type="button" class="auth-gate__link" data-auth-gate-login>
    Sign in
  </button>
</div>
<div data-auth-gate-content hidden>
  <slot />
</div>

<style>
  .auth-gate {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--color-gray-400, #ced4da);
    border-radius: 6px;
    background: var(--color-gray-100, #f8f9fa);
    color: var(--color-gray-800, #495057);
    font-size: 0.9rem;
  }

  .auth-gate__icon {
    flex-shrink: 0;
    color: var(--color-gray-700, #6c757d);
  }

  .auth-gate__text {
    margin: 0;
    flex: 1 1 auto;
    min-width: 12rem;
  }

  .auth-gate__link {
    flex-shrink: 0;
    color: #fff;
    background: var(--color-accent, #0d6efd);
    padding: 0.35rem 0.9rem;
    border: none;
    border-radius: 4px;
    font: inherit;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .auth-gate__link:hover {
    filter: brightness(0.92);
  }
</style>

<script>
  import { currentPagePath, getCurrentUser, login } from "../lib/auth0Client";

  async function revealIfAuthenticated() {
    const gates = document.querySelectorAll<HTMLElement>("[data-auth-gate]");
    if (!gates.length) {
      return;
    }

    const user = await getCurrentUser();
    if (!user) {
      return;
    }

    for (const gate of gates) {
      const content = gate.nextElementSibling;
      if (content instanceof HTMLElement && "authGateContent" in content.dataset) {
        gate.hidden = true;
        content.hidden = false;
      }
    }
  }

  void revealIfAuthenticated();

  document
    .querySelectorAll<HTMLButtonElement>("[data-auth-gate-login]")
    .forEach((button) => {
      button.addEventListener("click", () => {
        login(currentPagePath()).catch((error: unknown) => {
          console.error("Unable to start Auth0 login:", error);
        });
      });
    });
</script>
