---
/**
 * Wraps a single piece of content (a PDF link, a video embed) that should
 * only render for signed-in attendees. Unauthenticated visitors see a
 * login prompt in its place instead of the whole page being blocked.
 */
interface Props {
  isAuthenticated: boolean;
  loginHref: string;
  label: string;
}

const { isAuthenticated, loginHref, label } = Astro.props;
---

{
  isAuthenticated ? (
    <slot />
  ) : (
    <div class="auth-gate" role="note">
      <svg
        class="auth-gate__icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <rect x="3" y="11" width="18" height="10" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <p class="auth-gate__text">Sign in to access the {label}.</p>
      <a class="auth-gate__link" href={loginHref}>
        Sign in
      </a>
    </div>
  )
}

<style>
  .auth-gate {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border: 1px dashed var(--color-gray-400, #ced4da);
    border-radius: 6px;
    background: var(--color-gray-100, #f8f9fa);
    color: var(--color-gray-800, #495057);
    font-size: 0.9rem;
  }

  .auth-gate__icon {
    flex-shrink: 0;
    color: var(--color-gray-700, #6c757d);
  }

  .auth-gate__text {
    margin: 0;
    flex: 1 1 auto;
    min-width: 12rem;
  }

  .auth-gate__link {
    flex-shrink: 0;
    color: #fff;
    background: var(--color-accent, #0d6efd);
    padding: 0.35rem 0.9rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .auth-gate__link:hover {
    filter: brightness(0.92);
  }
</style>
