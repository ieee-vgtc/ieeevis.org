---
/**
 * Paper Detail Component
 * Displays comprehensive information about a single paper
 * Based on VIS 2025 paper page design
 */
import type { Paper } from '../types/paper';
import { getPaperImageUrl } from '../types/paper';

interface Props {
  paper: Paper;
  prevPaper?: Paper | null;
  nextPaper?: Paper | null;
}

const { paper, prevPaper, nextPaper } = Astro.props;
const imageUrl = getPaperImageUrl(paper);
---

<article class="paper-detail">
  <!-- Paper Title (no colored background) -->
  <h1 class="paper-title">{paper.title}</h1>
  
  <!-- Bookmark Icon -->
  <button class="bookmark-btn" id="bookmarkBtn" aria-label="Bookmark this paper">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>
    <span>Bookmark</span>
  </button>

  <!-- Authors with icon -->
  <div class="paper-authors">
    {paper.authors.map((author, index) => (
      <h4 key={index}>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="author-icon">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        {author.name}
        {author.affiliation && <span class="affiliation"> - {author.affiliation}</span>}
      </h4>
    ))}
  </div>

  <!-- Preview Image with icon -->
  {imageUrl && (
    <div class="paper-image-container">
      <img 
        src={imageUrl} 
        alt={`Figure for ${paper.title}`}
        onerror="this.style.display='none'"
      />
    </div>
  )}

  <!-- Download Links -->
  <div class="paper-links">
    {paper.preprint_link && (
      <h5>
        <a href={paper.preprint_link} target="_blank" rel="noopener noreferrer">
          Download preprint PDF
        </a>
      </h5>
    )}

    {paper.open_access_supplemental_link && (
      <h5>
        <a href={paper.open_access_supplemental_link} target="_blank" rel="noopener noreferrer">
          Download Supplemental Material
        </a>
      </h5>
    )}

    {paper.doi && (
      <h5>
        <a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer">
          DOI: {paper.doi}
        </a>
      </h5>
    )}
  </div>

  <!-- Session Information -->
  {paper.session_title && (
    <div class="paper-section">
      <h3>Session: {paper.session_title}</h3>
      {paper.session_room && paper.session_room !== 'None' && (
        <h3>Room: {paper.session_room}</h3>
      )}
    </div>
  )}

  <!-- Time Information -->
  {paper.time_stamp && (
    <h5>{paper.time_stamp}</h5>
  )}

  <!-- Video Link -->
  {(paper.session_youtube_prerecorded_id || paper.prerecorded_video_id) && (
    <p>
      Recorded video from this session can be viewed at the following link.
      <a 
        href={`https://youtu.be/${paper.session_youtube_prerecorded_id || paper.prerecorded_video_id}`}
        target="_blank" 
        rel="noopener noreferrer"
      >
        https://youtu.be/{paper.session_youtube_prerecorded_id || paper.prerecorded_video_id}
      </a>
    </p>
  )}

  <!-- Keywords -->
  {paper.keywords && paper.keywords.length > 0 && (
    <div class="paper-section">
      <h5>Keywords</h5>
      <p class="keywords-text">
        {paper.keywords.join(', ')}
      </p>
    </div>
  )}

  <!-- Abstract -->
  <div class="paper-section">
    <h5>Abstract</h5>
    <p>{paper.abstract}</p>
  </div>

  <!-- Practitioners Statement -->
  {paper.practitioners_statement && (
    <div class="paper-section">
      <h5>For Practitioners</h5>
      <p>{paper.practitioners_statement}</p>
    </div>
  )}

  <!-- Award Badge -->
  {paper.award && (
    <div class="paper-award">
      🏆 {paper.award === 'best' ? 'Best Paper Award' : 'Honorable Mention'}
    </div>
  )}
</article>

<!-- Paper Navigation at Bottom -->
<nav class="paper-navigation-bottom" aria-label="Paper navigation">
  <div class="nav-prev">
    {prevPaper ? (
      <a href={`/program/paper/${prevPaper.id}`} title={prevPaper.title}>
        <span class="nav-arrow">←</span> Previous
      </a>
    ) : (
      <span class="nav-disabled">
        <span class="nav-arrow">←</span> Previous
      </span>
    )}
  </div>
  <div class="nav-center">
    <a href="/year/2026/program/papers">All Papers</a>
  </div>
  <div class="nav-next">
    {nextPaper ? (
      <a href={`/program/paper/${nextPaper.id}`} title={nextPaper.title}>
        Next <span class="nav-arrow">→</span>
      </a>
    ) : (
      <span class="nav-disabled">
        Next <span class="nav-arrow">→</span>
      </span>
    )}
  </div>
</nav>

<style>
  .paper-detail {
    max-width: 100%;
    width: 100%;
    line-height: 1.6;
  }

  .paper-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    line-height: 1.2;
    color: #000;
  }

  .bookmark-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    cursor: pointer;
    font-size: 0.9rem;
    color: #495057;
    transition: all 0.2s;
    margin-bottom: 1.5rem;
  }

  .bookmark-btn:hover {
    background-color: #f8f9fa;
    border-color: #007bff;
    color: #007bff;
  }

  .bookmark-btn.bookmarked {
    background-color: #007bff;
    color: white;
    border-color: #007bff;
  }

  .bookmark-btn.bookmarked svg {
    fill: white;
  }

  .paper-authors {
    margin-bottom: 2rem;
  }

  .paper-authors h4 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: normal;
    margin: 0.5rem 0;
    color: #333;
  }

  .author-icon {
    flex-shrink: 0;
  }

  .affiliation {
    color: #666;
  }

  .paper-image-container {
    margin: 2rem 0;
  }

  .paper-image-container img {
    max-width: 100%;
    height: auto;
    display: block;
    border: 1px solid #dee2e6;
  }

  .paper-links {
    margin: 2rem 0;
  }

  .paper-links h5 {
    margin: 0.75rem 0;
    font-size: 1rem;
    font-weight: normal;
  }

  .paper-links a {
    color: #007bff;
    text-decoration: none;
  }

  .paper-links a:hover {
    text-decoration: underline;
  }

  .paper-section {
    margin: 2rem 0;
  }

  .paper-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1rem 0;
    color: #000;
  }

  .paper-section h5 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1rem 0 0.5rem 0;
    color: #000;
  }

  .paper-section p {
    margin: 0.5rem 0;
    color: #333;
    text-align: justify;
  }

  .keywords-text {
    color: #495057;
  }

  h5 {
    font-size: 1rem;
    font-weight: normal;
    margin: 0.75rem 0;
    color: #333;
  }

  p {
    margin: 0.75rem 0;
    color: #333;
    text-align: justify;
  }

  p a {
    color: #007bff;
    text-decoration: none;
  }

  p a:hover {
    text-decoration: underline;
  }

  .paper-award {
    margin: 2rem 0;
    padding: 1rem;
    background-color: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 4px;
    font-weight: 600;
  }

  .paper-navigation-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0 1rem 0;
    margin-top: 3rem;
    border-top: 1px solid #dee2e6;
    font-size: 0.95rem;
  }

  .paper-navigation-bottom a {
    color: #007bff;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: background-color 0.2s;
  }

  .paper-navigation-bottom a:hover {
    background-color: #f8f9fa;
  }

  .nav-arrow {
    font-weight: bold;
  }

  .nav-disabled {
    color: #6c757d;
    padding: 0.5rem 1rem;
    cursor: not-allowed;
  }

  .nav-center {
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .paper-title {
      font-size: 1.75rem;
    }

    .paper-navigation-bottom {
      font-size: 0.875rem;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>

<script>
  // Bookmark functionality
  const bookmarkBtn = document.getElementById('bookmarkBtn');
  const paperId = window.location.pathname.split('/').pop();
  
  // Load bookmark state from localStorage
  function loadBookmarkState() {
    const bookmarks = JSON.parse(localStorage.getItem('paperBookmarks') || '[]');
    if (bookmarks.includes(paperId)) {
      bookmarkBtn?.classList.add('bookmarked');
      const span = bookmarkBtn?.querySelector('span');
      if (span) span.textContent = 'Bookmarked';
    }
  }
  
  // Toggle bookmark
  bookmarkBtn?.addEventListener('click', () => {
    let bookmarks = JSON.parse(localStorage.getItem('paperBookmarks') || '[]');
    const isBookmarked = bookmarks.includes(paperId);
    
    if (isBookmarked) {
      bookmarks = bookmarks.filter((id: string) => id !== paperId);
      bookmarkBtn.classList.remove('bookmarked');
      const span = bookmarkBtn.querySelector('span');
      if (span) span.textContent = 'Bookmark';
    } else {
      bookmarks.push(paperId);
      bookmarkBtn.classList.add('bookmarked');
      const span = bookmarkBtn.querySelector('span');
      if (span) span.textContent = 'Bookmarked';
    }
    
    localStorage.setItem('paperBookmarks', JSON.stringify(bookmarks));
  });
  
  // Initialize on page load
  loadBookmarkState();
</script>
