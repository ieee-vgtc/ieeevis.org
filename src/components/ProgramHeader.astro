---
type DayOption = {
  value: string;
  label: string;
};

type TypeOption = {
  value: string;
  label: string;
  count: number;
  color?: string;
};

interface Props {
  title: string;
  subtitleBefore: string;
  subtitleAfter?: string;
  showTimezoneDescription?: boolean;
  groupingNote?: string;
  timezoneLabel?: string;
  timezoneSelectId?: string;
  dayLabel?: string;
  daySelectId?: string;
  searchLabel?: string;
  searchInputId?: string;
  searchPlaceholder?: string;
  dayOptions?: DayOption[];
  typeOptions?: TypeOption[];
  allCount?: number;
  allLabel?: string;
  allDayLabel?: string;
  filterBarLabel?: string;
}

const {
  title,
  subtitleBefore,
  subtitleAfter = ".",
  showTimezoneDescription = true,
  groupingNote,
  timezoneLabel,
  timezoneSelectId,
  dayLabel,
  daySelectId,
  searchLabel,
  searchInputId,
  searchPlaceholder,
  dayOptions,
  typeOptions,
  allCount,
  allLabel = "All",
  allDayLabel = "All conference days",
  filterBarLabel = "Session type filters",
} = Astro.props as Props;
---

<div class="u-toolbar">
  <div>
    <p class="u-title">{title}</p>
    <p class="u-subtitle">
      {subtitleBefore}
      {
        showTimezoneDescription && (
          <span class="js-tz-description"> conference timezone </span>
        )
      }
      {subtitleAfter}
    </p>
    {
      groupingNote !== undefined && (
        <p class="u-grouping-note js-day-grouping-note">{groupingNote}</p>
      )
    }
  </div>

  <div class="u-controls">
    {
      timezoneLabel && timezoneSelectId && (
        <label class="u-control">
          {timezoneLabel}
          <select id={timezoneSelectId} class="u-select">
            <option value="conference">Conference timezone</option>
            <option value="local">My local timezone</option>
            <option value="both">Conference and local</option>
          </select>
        </label>
      )
    }

    {
      dayLabel && daySelectId && dayOptions && (
        <label class="u-control">
          {dayLabel}
          <select id={daySelectId} class="u-select">
            <option value="all">{allDayLabel}</option>
            {dayOptions.map((dayOption) => (
              <option value={dayOption.value}>{dayOption.label}</option>
            ))}
          </select>
        </label>
      )
    }

    {
      searchLabel && searchInputId && searchPlaceholder && (
        <label class="u-control">
          {searchLabel}
          <input
            id={searchInputId}
            class="u-search"
            type="search"
            placeholder={searchPlaceholder}
            aria-label={searchLabel}
          />
        </label>
      )
    }

    <slot name="extra-controls" />
  </div>
</div>

{
  typeOptions && typeOptions.length > 0 && (
    <div class="u-filter-bar" role="toolbar" aria-label={filterBarLabel}>
      <button
        class="u-filter-pill is-active"
        type="button"
        data-type-filter="all"
        style="--pill-color: #374151"
        aria-pressed="true"
      >
        <span>{allLabel}</span>
        <span class="u-filter-count">{allCount || 0}</span>
      </button>

      {typeOptions.map((typeOption) => (
        <button
          class="u-filter-pill"
          type="button"
          data-type-filter={typeOption.value}
          style={`--pill-color: ${typeOption.color || "#6b7280"}`}
          aria-pressed="false"
        >
          <span>{typeOption.label}</span>
          <span class="u-filter-count">{typeOption.count}</span>
        </button>
      ))}
    </div>
  )
}
